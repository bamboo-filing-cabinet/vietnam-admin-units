    "Đức Bình"@vi
    "Đức Châu"@vi
    "Đức Lập"@vi
    "Đức Minh"@vi
    "Đức Nhàn"@vi
    "Đức Phú"@vi
    "Ứng Hòa"@vi
    "Ứng Thiên"@vi
    }
    ?item skos:altLabel ?matchedTerm .
    BIND("alias" AS ?matchKind)
  }
}
ORDER BY ?item ?matchedTerm ?matchKind
