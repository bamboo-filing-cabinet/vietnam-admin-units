\par }\pard \qj\fi547\sb200\widctlpar\adjustright {\b \'a7i\'d2u 1.}{ Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 thu\'e9c c\'b8c huy\'d6n C\'b8i N\'ad\'edc v\'b5 Ph\'f3 T\'a9n, t\'d8nh C\'b5 Mau nh\'ad sau :
\par 1. Th\'b5nh l\'cbp x\'b7 Th\'b9nh Ph\'f3 huy\'d6n C\'b8i N\'ad\'edc tr\'aan c\'ac s\'eb 3.111 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.725 nh\'a9n kh\'c8u c\'f1a x\'b7 L\'ad\'acng Th\'d5 Tr\'a9n.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Th\'b9nh Ph\'f3 : \'a7\'abng gi\'b8p x\'b7 L\'ad\'acng Th\'d5 Tr\'a9n; T\'a9y gi\'b8p x\'b7 Ph\'f3 H\'adng; Nam gi\'b8p x\'b7 T\'a9n H\'adng; B\'bec Gi\'b8p huy\'d6n Tr\'c7n V\'a8n Th\'eai v\'b5 th\'b5nh ph\'e8 C
\'b5 Mau.
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Th\'b9nh Ph\'f3, x\'b7 L\'ad\'acng Th\'d5 Tr\'a9n c\'dfn l\'b9i 3.024 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.079 nh\'a9n kh\'c8u.
\par 2. Th\'b5nh l\'cbp x\'b7 Ho\'b5 M\'fc thu\'e9c huy\'d6n C\'b8i N\'ad\'edc tr\'aan c\'ac s\'eb 3.860,20 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.326 nh\'a9n kh\'c8u c\'f1a x\'b7 H\'adng M\'fc.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ho\'b5 M\'fc : \'a7\'abng gi\'b8p c\'b8c x\'b7 T\'a9n H\'adng, \'a7\'abng Th\'edi; T\'a9y gi\'b8p huy\'d6n Ph\'f3 T\'a9n; Nam gi\'b8p x\'b7 T\'a9n H\'adng \'a7\'abng; B\'bec gi\'b8p x\'b7 H\'adng M\'fc.
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Ho\'b5 M\'fc, x\'b7 H\'adng M\'fc c\'dfn l\'b9i 2.977,80 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.885 nh\'a9n kh\'c8u.
\par }{\expnd0\expndtw-4 3. Th\'b5nh l\'cbp x\'b7 \'a7\'abng H\'adng thu\'e9c huy\'d6n C\'b8i N\'ad\'edc tr\'aan c\'ac s\'eb 3.283,40 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.299 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'abng Th\'edi.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'abng H\'adng : \'a7\'abng gi\'b8p huy\'d6n \'a7\'c7m D\'aci; T\'a9y gi\'b8p c\'b8c x\'b7 T\'a9n H\'adng \'a7\'abng, H\'adng M\'fc; Nam gi\'b8p x\'b7 \'a7\'abng Th\'edi; B\'bec gi\'b8p x\'b7 T\'a9n H\'adng.

\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 \'a7\'abng H\'adng, x\'b7 \'a7\'abng Th\'edi c\'dfn l\'b9i 2.926,60 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.715 nh\'a9n kh\'c8u.
\par 4. Th\'b5nh l\'cbp x\'b7 Ph\'f3 Thu\'cbn thu\'e9c huy\'d6n Ph\'f3 T\'a9n tr\'aan c\'ac s\'eb 3.925 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.359 nh\'a9n kh\'c8u c\'f1a x\'b7 Ph\'f3 M\'fc.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ph\'f3 Thu\'cbn : \'a7\'abng gi\'b8p huy\'d6n C\'b8i N\'ad\'edc; T\'a9y gi\'b8p x\'b7 Ph\'f3 M\'fc; Nam gi\'b8p c\'b8c x\'b7 T\'a9n H\'adng T\'a9y, Vi\'d6t Th\'beng; B\'bec gi\'b8p huy\'d6n Tr\'c7n V\'a8n Th\'eai.

\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Ph\'f3 Thu\'cbn, x\'b7 Ph\'f3 M\'fc c\'dfn l\'b9i 4.114,51 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.231 nh\'a9n kh\'c8u.
\par 5. Th\'b5nh l\'cbp x\'b7 R\'b9ch Ch\'cco thu\'e9c huy\'d6n Ph\'f3 T\'a9n tr\'aan c\'ac s\'eb 4.450 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.998 nh\'a9n kh\'c8u c\'f1a x\'b7 T\'a9n H\'adng T\'a9y.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 R\'b9ch Ch\'cco: \'a7\'abng gi\'b8p x\'b7 Vi\'d6t Th\'beng; T\'a9y gi\'b8p x\'b7 Nguy\'d4n Vi\'d6t Kh\'b8i; Nam gi\'b8p huy\'d6n N\'a8m C\'a8n; B\'bec gi\'b8p x\'b7 T\'a9n H\'adng T\'a9y.
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 R\'b9ch Ch\'cco, x\'b7 T\'a9n H\'adng T\'a9y c\'dfn l\'b9i 3.953 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.426 nh\'a9n kh\'c8u.
\par }{\b \'a7i\'d2u 2.}{ Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng       C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.

\par }{\b \'a7i\'d2u 3.}{ Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh C\'b5 Mau, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n\'b5
y ./.
