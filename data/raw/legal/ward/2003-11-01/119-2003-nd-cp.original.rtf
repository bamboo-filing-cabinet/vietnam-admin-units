\par }\pard \qj\fi547\ri-86\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 1}{\b\i\cf1 . }{\cf1 Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp x\'b7, th\'de tr\'can thu\'e9c c\'b8c huy\'d6n : Ch\'ee M\'edi, Tri T\'abn, T\'denh Bi
\'aan v\'b5 Ph\'f3 T\'a9n, t\'d8nh An Giang nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp th\'de tr\'can M\'fc Lu\'abng thu\'e9c huy\'d6n Ch\'ee M\'edi tr\'aan c\'ac s\'eb 808 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 15.540 nh\'a9n kh\'c8u c\'f1a x\'b7 M\'fc Lu\'abng.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can M\'fc Lu\'abng : \'a7\'abng gi\'b8p c\'b8c x\'b7 T\'can M\'fc, M\'fc An; T\'a9y gi\'b8p c\'b8c x\'b7 Long \'a7i\'d2n B, Long Ki\'d5n; Nam gi\'b8p c\'b8c x\'b7 Long Ki\'d5n, M\'fc An; B\'bec gi\'b8p c\'b8
c x\'b7 Long \'a7i\'d2n A, T\'can M\'fc.
\par 
\par Sau khi th\'b5nh l\'cbp th\'de tr\'can M\'fc Lu\'abng, x\'b7 M\'fc Lu\'abng c\'dfn l\'b9i 1.241 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.466 nh\'a9n kh\'c8u. \'a7\'e6i t\'aan x\'b7 M\'fc Lu\'abng th\'b5nh x\'b7 M\'fc An.
\par 
\par 2. Th\'b5nh l\'cbp th\'de tr\'can Ba Ch\'f3c thu\'e9c huy\'d6n Tri T\'abn tr\'aan c\'ac s\'eb 2.056 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.122 nh\'a9n kh\'c8u c\'f1a x\'b7 Ba Ch\'f3c.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can Ba Ch\'f3c : \'a7\'abng gi\'b8p x\'b7 L\'aa Tr\'d7; T\'a9y gi\'b8p x\'b7 V\'dcnh Ph\'ad\'edc; Nam gi\'b8p x\'b7 L\'ad\'acng Phi; B\'bec gi\'b8p x\'b7 L\'b9c Qu\'edi.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can Ba Ch\'f3c, x\'b7 Ba Ch\'f3c c\'dfn l\'b9i 6.471 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.658 nh\'a9n kh\'c8u. \'a7\'e6i t\'aan x\'b7 Ba Ch\'f3c th\'b5nh x\'b7
 V\'dcnh Ph\'ad\'edc.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 N\'f3i Voi thu\'e9c huy\'d6n T\'denh Bi\'aan tr\'aan c\'ac s\'eb 1.225 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.387 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Chi L\'a8ng.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 N\'f3i Voi : \'a7\'abng gi\'b8p huy\'d6n Ch\'a9u Ph\'f3; T\'a9y gi\'b8p th\'de tr\'can Chi L\'a8ng; Nam gi\'b8p x\'b7 T\'a9n L\'eei; B\'bec gi\'b8p x\'b7 V\'dcnh Trung.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 N\'f3i Voi, th\'de tr\'can Chi L\'a8ng c\'dfn l\'b9i 713 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.372 nh\'a9n kh\'c8u.
\par 
\par 4. Th\'b5nh l\'cbp x\'b7 T\'a9n Trung thu\'e9c huy\'d6n Ph\'f3 T\'a9n tr\'aan c\'ac s\'eb 790,15 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.163 nh\'a9n kh\'c8u c\'f1a x\'b7 T\'a9n Ho\'b5.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 T\'a9n Trung : \'a7\'abng gi\'b8p huy\'d6n Ch\'ee M\'edi; T\'a9y gi\'b8p x\'b7 T\'a9n Ho\'b5; Nam gi\'b8p c\'b8c huy\'d6n Ch\'a9u Ph\'f3. Ch\'ee M\'edi; B\'bec gi\'b8p x\'b7 T\'a9n Ho\'b5, th\'de tr\'can Ph\'f3 M
\'fc v\'b5 t\'d8nh \'a7\'e5ng Th\'b8p.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 T\'a9n Trung, x\'b7 T\'a9n Ho\'b5 c\'dfn l\'b9i 921,85 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8,188 nh\'a9n kh\'c8u.
\par 
\par }{\b\cf1 \'a7i\'d2u 2}{\cf1 . Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.

\par 
\par }{\b\cf1 \'a7i\'d2u 3}{\cf1 . Ch\'f1 t\'dech }{\f17\expnd0\expndtw-4\cf1 \'f1}{\expnd0\expndtw-4\cf1 y ban}{\cf1  nh\'a9n d\'a9n t\'d8nh An Giang, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'de
u tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh             n\'b5y ./.
