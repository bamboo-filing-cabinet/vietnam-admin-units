\par }\pard \qc\ri11\sb240\widctlpar\adjustright {\b\f17\fs26 Ngh\'de \'ae\'denh :
\par }\pard \qj\fi540\ri11\widctlpar\adjustright {
\par }{\b \'a7i\'d2u 1. }{Nay th\'b5nh l\'cbp th\'de tr\'can thu\'e9c c\'b8c huy\'d6n Qu\'fanh Ph\'f4, H\'adng H\'b5 v\'b5 chia x\'b7 B\'d7nh L\'a8ng thu\'e9c huy\'d6n H\'adng H\'b5, t\'d8nh Th\'b8i B\'d7nh nh\'ad sau:
\par 
\par 1. Th\'b5nh l\'cbp th\'de tr\'can An B\'b5i thu\'e9c huy\'d6n Qu\'fanh Ph\'f4 tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a x\'b7 An B\'b5i.
\par 
\par Th\'de tr\'can An B\'b5i c\'e3 700,18 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.381 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can An B\'b5i: \'a7\'abng gi\'b8p x\'b7 An Thanh v\'b5 th\'b5nh ph\'e8 H\'b6i Ph\'dfng; T\'a9y gi\'b8p c\'b8c x\'b7 An Ninh, An V\'f2; Nam gi\'b8p c\'b8c x\'b7 An V\'f2, An Thanh; B\'bec gi\'b8p x\'b7
 An Ninh v\'b5 th\'b5nh ph\'e8 H\'b6i Ph\'dfng.
\par 
\par 2. Th\'b5nh l\'cbp th\'de tr\'can H\'adng Nh\'a9n thu\'e9c huy\'d6n H\'adng H\'b5 tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a x\'b7 Ph\'f3 S\'acn.
\par 
\par Th\'de tr\'can H\'adng Nh\'a9n c\'e3 864,40 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 14.495 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can H\'adng Nh\'a9n: \'a7\'abng gi\'b8p c\'b8c x\'b7 T\'a9n Ho\'b5, Li\'aan Hi\'d6p; T\'a9y gi\'b8p x\'b7 T\'a9n L\'d4; Nam gi\'b8p x\'b7 Ti\'d5n \'a7\'f8c v\'b5 t\'d8nh H\'b5 Nam; B\'bec gi\'b8p c\'b8c x\'b7
 T\'a9n L\'d4, Canh T\'a9n.
\par 
\par 3. Chia x\'b7 B\'d7nh L\'a8ng thu\'e9c huy\'d6n H\'adng H\'b5 th\'b5nh x\'b7 Ho\'b5 B\'d7nh v\'b5 x\'b7 Chi L\'a8ng.
\par 
\par - X\'b7 Ho\'b5 B\'d7nh c\'e3 340,44 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.948 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ho\'b5 B\'d7nh: \'a7\'abng gi\'b8p c\'b8c x\'b7 T\'a9y \'a7\'ab, Chi L\'a8ng; T\'a9y gi\'b8p c\'b8c x\'b7 Minh Khai, H\'e5ng L\'dcnh; Nam gi\'b8p c\'b8c x\'b7 H\'e5ng L\'dcnh, Chi L\'a8ng; B\'bec gi\'b8p x\'b7 Th
\'e8ng Nh\'cat.
\par 
\par - X\'b7 Chi L\'a8ng c\'e3 344,25 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.834 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Chi L\'a8ng: \'a7\'abng gi\'b8p huy\'d6n \'a7\'abng H\'adng; T\'a9y gi\'b8p x\'b7 Ho\'b5 B\'d7nh; Nam gi\'b8p x\'b7 H\'e5ng L\'dcnh v\'b5 huy\'d6n \'a7\'abng H\'adng; B\'bec gi\'b8p x\'b7 T\'a9y \'a7\'ab.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par }{\b 
\par \'a7i\'d2u 3. }{\f17\cf1 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh Th\'b8i B\'d7nh, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n\'b5y ./.
\par 
