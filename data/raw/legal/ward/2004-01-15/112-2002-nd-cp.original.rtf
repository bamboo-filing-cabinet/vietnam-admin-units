\par }\pard \s15\qj\fi547\widctlpar\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp x\'b7 thu\'e9c c\'b8c huy\'d6n L\'a9m H\'b5, \'a7\'b9 Huoai, \'a7\'b9 T\'ceh, C\'b8t Ti\'aan, t\'d8nh L\'a9
m \'a7\'e5ng nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp x\'b7 Nam H\'b5 thu\'e9c huy\'d6n L\'a9m H\'b5 tr\'aan c\'ac s\'eb 2.345 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.103 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Nam Ban.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Nam H\'b5 : \'a7\'abng gi\'b8p th\'de tr\'can Nam Ban; T\'a9y gi\'b8p c\'b8c x\'b7 Phi T\'ab, \'a7\'b9 \'a7\'ean; Nam gi\'b8p th\'de tr\'can \'a7inh V\'a8n v\'b5 huy\'d6n \'a7\'f8c Tr\'e4ng; B\'bec gi\'b8p x\'b7 M
\'aa Linh.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 Nam H\'b5, th\'de tr\'can Nam Ban c\'dfn l\'b9i 2.089 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.912 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp x\'b7 Ph\'ad\'edc L\'e9c thu\'e9c huy\'d6n \'a7\'b9 Huoai tr\'aan c\'ac s\'eb 7.766 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.008 nh\'a9n kh\'c8u c\'f1a x\'b7 H\'b5 L\'a9m.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ph\'ad\'edc l\'e9c : \'a7\'abng gi\'b8p x\'b7 \'a7\'b9 M'Ri; T\'a9y gi\'b8p x\'b7 \'a7\'b9 T\'e5n; Nam gi\'b8p x\'b7 H\'b5 L\'a9m v\'b5 th\'de tr\'can Ma \'a7a Gui; B\'bec gi\'b8p huy\'d6n \'a7\'b9 T\'ceh.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 Ph\'ad\'edc L\'e9c, x\'b7 H\'b5 L\'a9m c\'dfn l\'b9i 4.414 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.611 nh\'a9n kh\'c8u.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 \'a7\'b9 Pal thu\'e9c huy\'d6n \'a7\'b9 T\'ceh tr\'aan c\'ac s\'eb 4.600 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.834 nh\'a9n kh\'c8u c\'f1a x\'b7 Tri\'d6u H\'b6i.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'b9 Pal : \'a7\'abng gi\'b8p c\'b8c huy\'d6n B\'b6o L\'a9m v\'b5 \'a7\'b9 Huoai; T\'a9y gi\'b8p x\'b7 Qu\'b6ng Tr\'de; Nam gi\'b8p x\'b7 Tri\'d6u H\'b6i; B\'bec gi\'b8p x\'b7 Qu\'b6ng Tr\'de.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'b9 Pal, x\'b7 Tri\'d6u H\'b6i c\'dfn l\'b9i 3.900 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.956 nh\'a9n kh\'c8u.
\par 
\par }{\expnd-1\expndtw-6 4. Th\'b5nh l\'cbp x\'b7 \'a7\'e5ng Nai Th\'ad\'eeng thu\'e9c huy\'d6n C\'b8t Ti\'aan tr\'aan c\'ac s\'eb 9.395 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.429 nh\'a9n kh\'c8u c\'f1a x\'b7 Ti\'aan Ho\'b5ng.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'e5ng Nai Th\'ad\'eeng : \'a7\'abng gi\'b8p huy\'d6n B\'b6o L\'a9m; T\'a9y gi\'b8p x\'b7 Ph\'ad\'edc C\'b8t 2; Nam gi\'b8p x\'b7 Ti\'aan Ho\'b5ng v\'b5 huy\'d6n \'a7\'b9 T\'ceh; B\'bec gi\'b8p t\'d8nh \'a7\'be
k L\'bek.
\par 
\par }{\expnd-1\expndtw-6 Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'e5ng Nai Th\'ad\'eeng, x\'b7 Ti\'aan Ho\'b5ng c\'dfn l\'b9i 5.022,91 h}{a di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.726 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2.}{ Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y k\'fd. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
\par }{\b \'a7i\'d2u 3. }{Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh L\'a9m \'a7\'e5ng, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'de
nh n\'b5y ./.
