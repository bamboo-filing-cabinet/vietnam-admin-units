\par }\pard \qj\fi540\sb240\sl288\slmult1\widctlpar\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp x\'b7 thu\'e9c c\'b8c huy\'d6n C\'ad M'gar, \'a7\'bek R'L\'cap, Kr\'abng B\'abng, Kr\'ab
ng Ana, Ea Kar, t\'d8nh \'a7\'bek L\'bek nh\'ad sau :
\par 1. Th\'b5nh l\'cbp x\'b7 Qu\'b6ng Hi\'d6p thu\'e9c huy\'d6n C\'ad M'gar tr\'aan c\'ac s\'eb 5.470 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.092 nh\'a9n kh\'c8u c\'f1a x\'b7 Ea M'Dr\'e3h.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Qu\'b6ng Hi\'d6p : \'a7\'abng gi\'b8p c\'b8c x\'b7 Ea H'Ding, C\'ad M'gar; T\'a9y gi\'b8p huy\'d6n Bu\'abn \'a7\'abn; Nam gi\'b8p x\'b7 Ea Mnang v\'b5 huy\'d6n Bu\'abn \'a7\'abn; B\'bec gi\'b8p x\'b7 Ea M'Dr\'e3h.

\par Sau khi th\'b5nh l\'cbp x\'b7 Qu\'b6ng Hi\'d6p, x\'b7 Ea M'Dr\'e3h c\'dfn l\'b9i 5.810 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.958 nh\'a9n kh\'c8u.
\par 2. Th\'b5nh l\'cbp x\'b7 Nh\'a9n \'a7\'b9o thu\'e9c huy\'d6n \'a7\'bek R'L\'cap tr\'aan c\'ac s\'eb 6.500 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.051 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'b9o Ngh\'dca.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Nh\'a9n \'a7\'b9o : \'a7\'abng gi\'b8p huy\'d6n \'a7\'bek N\'abng v\'b5 t\'d8nh L\'a9m \'a7\'e5ng; T\'a9y gi\'b8p x\'b7 \'a7\'b9o Ngh\'dca; Nam gi\'b8p x\'b7 \'a7\'b9o Ngh\'dca v\'b5 t\'d8nh L\'a9m \'a7\'e5ng; B
\'bec gi\'b8p x\'b7 Nh\'a9n C\'ac.
\par Sau khi th\'b5nh l\'cbp x\'b7 Nh\'a9n \'a7\'b9o, x\'b7 \'a7\'b9o Ngh\'dca c\'dfn l\'b9i 10.974 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.021 nh\'a9n kh\'c8u.
\par 3. Th\'b5nh l\'cbp x\'b7 Yang Reh thu\'e9c huy\'d6n Kr\'abng B\'abng tr\'aan c\'ac s\'eb 2.939 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.110 nh\'a9n kh\'c8u c\'f1a x\'b7 Ea Trul.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Yang Reh : \'a7\'abng gi\'b8p x\'b7 Ea Trul; T\'a9y gi\'b8p huy\'d6n Kr\'abng Ana; Nam gi\'b8p huy\'d6n L\'bek; B\'bec gi\'b8p huy\'d6n Kr\'abng Ana.
\par Sau khi th\'b5nh l\'cbp x\'b7 Yang Reh, x\'b7 Ea Trul c\'dfn l\'b9i 2.489 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.400 nh\'a9n kh\'c8u.
\par 4. Th\'b5nh l\'cbp x\'b7 B\'a8ng A Dr\'aanh thu\'e9c huy\'d6n Kr\'abng Ana tr\'aan c\'ac s\'eb     4.390 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.459 nh\'a9n kh\'c8u c\'f1a x\'b7 Dur Km\'a8l.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 B\'a8ng A Dr\'aanh : \'a7\'abng gi\'b8p x\'b7 H\'dfa Hi\'d6p; T\'a9y gi\'b8p th\'de tr\'can Bu\'abn Tr\'cap; Nam gi\'b8p x\'b7 Dur Km\'a8l; B\'bec gi\'b8p c\'b8c x\'b7 H\'dfa Hi\'d6p v\'b5 Ea B\'abng.
\par Sau khi th\'b5nh l\'cbp x\'b7 B\'a8ng A Dr\'aanh, x\'b7 Dur Km\'a8l c\'dfn l\'b9i 7.166 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.467 nh\'a9n kh\'c8u.
\par 5. Chia x\'b7 C\'ad Jiang thu\'e9c huy\'d6n Ea Kar th\'b5nh x\'b7 C\'ad B\'abng v\'b5 C\'ad Yang.
\par - X\'b7 C\'ad B\'abng c\'e3 8.885 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.064 nh\'a9n kh\'c8u.
