\par }\pard\plain \qj\fi533\sb200\widctlpar\adjustright \f15\fs28\cgrid {1. Th\'b5nh l\'cbp ph\'ad\'eang Tr\'c7n H\'adng \'a7\'b9o thu\'e9c th\'de x\'b7 Kon Tum tr\'aan c\'ac s\'eb 590 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.857 nh\'a9n kh\'c8u c\'f1a x\'b7
 H\'dfa B\'d7nh.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Tr\'c7n H\'adng \'a7\'b9o: \'a7\'abng gi\'b8p x\'b7 Ch\'ad H\rquote Reng; T\'a9y v\'b5 Nam gi\'b8p x\'b7 H\'dfa B\'d7nh; B\'bec gi\'b8p c\'b8c ph\'ad\'eang Nguy\'d4n Tr\'b7i, L\'aa L\'eei.
\par Sau khi th\'b5nh l\'cbp ph\'ad\'eang Tr\'c7n H\'adng \'a7\'b9o, x\'b7 H\'dfa B\'d7nh c\'dfn l\'b9i 6.075 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.483 nh\'a9n kh\'c8u.
\par 2. Th\'b5nh l\'cbp ph\'ad\'eang Ng\'ab M\'a9y thu\'e9c th\'de x\'b7 Kon Tum tr\'aan c\'ac s\'eb 550 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.035 nh\'a9n kh\'c8u c\'f1a x\'b7 Vinh Quang.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ng\'ab M\'a9y: \'a7\'abng gi\'b8p ph\'ad\'eang Duy T\'a9n; T\'a9y, Nam v\'b5 B\'bec gi\'b8p x\'b7 Vinh Quang.
\par Sau khi th\'b5nh l\'cbp ph\'ad\'eang Ng\'ab M\'a9y, x\'b7 Vinh Quang c\'dfn l\'b9i 2.176 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.945 nh\'a9n kh\'c8u.
\par 3. Th\'b5nh l\'cbp ph\'ad\'eang Nguy\'d4n Tr\'b7i thu\'e9c th\'de x\'b7 Kon Tum tr\'aan c\'ac s\'eb 600 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.889 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7o\'b5n K\'d5t.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Nguy\'d4n Tr\'b7i: \'a7\'abng gi\'b8p ph\'ad\'eang L\'aa L\'eei; T\'a9y gi\'b8p x\'b7 \'a7o\'b5n K\'d5t; Nam gi\'b8p ph\'ad\'eang Tr\'c7n H\'adng \'a7\'b9o; B\'bec gi\'b8p ph\'ad\'eang Quy\'d5t Th\'beng v
\'b5 x\'b7 Vinh Quang.
\par Sau khi th\'b5nh l\'cbp ph\'ad\'eang Nguy\'d4n Tr\'b7i, x\'b7 \'a7o\'b5n K\'d5t c\'dfn l\'b9i 2.115 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.064 nh\'a9n kh\'c8u.
\par 4. Th\'b5nh l\'cbp ph\'ad\'eang Tr\'ad\'eang Chinh thu\'e9c th\'de x\'b7 Kon Tum tr\'aan c\'ac s\'eb 196,68 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.563 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'bek Bl\'b5, 244,20 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5
 3.690 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Th\'beng L\'eei.
\par Ph\'ad\'eang Tr\'ad\'eang Chinh c\'e3 440,88 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.253 nh\'a9n kh\'c8u.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Tr\'ad\'eang Chinh: \'a7\'abng gi\'b8p c\'b8c x\'b7 \'a7\'bek Bl\'b5, \'a7\'bek R\'ac Wa; T\'a9y gi\'b8p c\'b8c ph\'ad\'eang Duy T\'a9n, Quang Trung; Nam gi\'b8p ph\'ad\'eang Th\'beng L\'eei; B\'bec gi\'b8
p x\'b7 \'a7\'bek C\'cam.\tab 
\par Sau khi th\'b5nh l\'cbp ph\'ad\'eang Tr\'ad\'eang Chinh:
\par - X\'b7 \'a7\'bek Bl\'b5 c\'dfn l\'b9i 4.116,32 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.841 nh\'a9n kh\'c8u.
\par }{\expnd-1\expndtw-8 - Ph\'ad\'eang Th\'beng L\'eei c\'dfn l\'b9i 515,80 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.689 nh\'a9n kh\'c8u.
\par }{5. Th\'b5nh l\'cbp x\'b7 \'a7\'bek T\'ac Lung thu\'e9c huy\'d6n Kon R\'c9y tr\'aan c\'ac s\'eb 12.420 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.250 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'bek Ru\'e5ng.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7  \'a7\'bek T\'ac Lung: \'a7\'abng gi\'b8p th\'de tr\'can \'a7\'bek R\'ac Ve v\'b5 x\'b7 T\'a9n L\'cbp; T\'a9y gi\'b8p huy\'d6n \'a7\'bek H\'b5; Nam gi\'b8p c\'b8c x\'b7 \'a7\'bek Ru\'e5ng, \'a7\'bek T\'ea Re; B\'be
c gi\'b8p x\'b7 \'a7\'bek K\'abi.
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'bek T\'ac Lung, x\'b7 \'a7\'bek Ru\'e5ng c\'dfn l\'b9i 6.700 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.155 nh\'a9n kh\'c8u.
\par 6. Th\'b5nh l\'cbp x\'b7 \'a7\'bek Kan thu\'e9c huy\'d6n Ng\'e4c H\'e5i tr\'aan c\'ac s\'eb 8.790 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.293 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'bek X\'f3, 250 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 635 nh\'a9n kh\'c8u c
\'f1a x\'b7 Sa Loong.
\par X\'b7 \'a7\'bek Kan c\'e3 9.040 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.928 nh\'a9n kh\'c8u.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek Kan: \'a7\'abng gi\'b8p huy\'d6n \'a7\'bek T\'ab; T\'a9y gi\'b8p c\'b8c x\'b7 B\'ea Y, Sa Loong; Nam gi\'b8p huy\'d6n Sa Th\'c7y; B\'bec gi\'b8p th\'de tr\'can Plei K\'c7n v\'b5 x\'b7 \'a7\'bek X\'f3.

\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'bek Kan:
\par - X\'b7 \'a7\'bek X\'f3 c\'dfn l\'b9i 11.920 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.369 nh\'a9n kh\'c8u.
\par - X\'b7 Sa Loong c\'dfn l\'b9i 17.760 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.965 nh\'a9n kh\'c8u.
\par 7. Th\'b5nh l\'cbp x\'b7 \'a7\'bek Long thu\'e9c huy\'d6n Kon Pl\'abng tr\'aan c\'ac s\'eb 13.555 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.054 nh\'a9n kh\'c8u c\'f1a x\'b7 M\'a8ng C\'b5nh.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek Long: \'a7\'abng gi\'b8p x\'b7 Hi\'d5u; T\'a9y gi\'b8p huy\'d6n Kon R\'c9y; Nam gi\'b8p huy\'d6n Kon R\'c9y v\'b5 t\'d8nh Gia Lai; B\'bec gi\'b8p x\'b7 M\'a8ng C\'b5nh.
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'bek Long, x\'b7 M\'a8ng C\'b5nh c\'dfn l\'b9i 14.335 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.002 nh\'a9n kh\'c8u.
\par 8. Th\'b5nh l\'cbp x\'b7 \'a7\'bek T\'a8ng thu\'e9c huy\'d6n Kon Pl\'abng tr\'aan c\'ac s\'eb 12.100 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.067 nh\'a9n kh\'c8u c\'f1a x\'b7 M\'a8ng B\'f3t.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek T\'a8ng: \'a7\'abng gi\'b8p x\'b7 Ng\'e4k Tem; T\'a9y gi\'b8p huy\'d6n \'a7\'bek H\'b5; Nam gi\'b8p x\'b7 M\'a8ng C\'b5nh v\'b5 huy\'d6n Kon R\'c9y; B\'bec gi\'b8p c\'b8c x\'b7 M\'a8ng B\'f3t, \'a7\'be
k Ring.
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'bek T\'a8ng, x\'b7 M\'a8ng B\'f3t c\'dfn l\'b9i 17.310 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.281 nh\'a9n kh\'c8u.
\par 9. Th\'b5nh l\'cbp x\'b7 \'a7\'bek N\'aan thu\'e9c huy\'d6n Kon Pl\'abng tr\'aan c\'ac s\'eb 12.973 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.027 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'bek Ring.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek N\'aan: \'a7\'abng gi\'b8p t\'d8nh Qu\'b6ng Ng\'b7i; T\'a9y gi\'b8p x\'b7 M\'a8ng B\'f3t v\'b5 t\'d8nh Qu\'b6ng Nam; Nam gi\'b8p x\'b7 \'a7\'bek Ring; B\'bec gi\'b8p t\'d8nh Qu\'b6ng Nam.
