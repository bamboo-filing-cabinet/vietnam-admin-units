\par }\pard\plain \qj\fi540\ri-1\widctlpar\adjustright \f15\fs28\cgrid {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh m\'eb r\'e9ng th\'de x\'b7 Ngh\'dca L\'e9 v\'b5 th\'de tr\'can Y\'aan Th\'d5 thu\'e9c huy\'d6n L\'f4c Y\'aa
n, t\'d8nh Y\'aan B\'b8i nh\'ad sau :
\par 
\par 1. Chuy\'d3n to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a c\'b8c x\'b7 Ngh\'dca An, Ngh\'dca L\'eei, Ngh\'dca Ph\'f3c thu\'e9c huy\'d6n V\'a8n Ch\'can v\'d2 th\'de x\'b7 Ngh\'dca L\'e9 qu\'b6n l\'fd.
\par 
\par Th\'de x\'b7 Ngh\'dca L\'e9 c\'e3 2.966,60 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 26.032 nh\'a9n kh\'c8u, c\'e3 7 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c l\'b5 c\'b8c ph\'ad\'eang Trung t\'a9m, T\'a9n An, P\'f3 Tr\'b9ng, C\'c7u Thia v\'b5 c\'b8
c x\'b7 Ngh\'dca An, Ngh\'dca L\'eei, Ngh\'dca Ph\'f3c.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de x\'b7 Ngh\'dca L\'e9 : \'a7\'abng, Nam, B\'bec gi\'b8p huy\'d6n V\'a8n Ch\'can; T\'a9y gi\'b8p huy\'d6n Tr\'b9m T\'cau.    
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh m\'eb r\'e9ng th\'de x\'b7 Ngh\'dca L\'e9 :
\par 
\par Huy\'d6n V\'a8n Ch\'can c\'dfn l\'b9i 120.517,50 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 137.953 nh\'a9n kh\'c8u; c\'e3 31 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c x\'b7 T\'a9n Th\'denh, \'a7\'b9i L\'dech, Minh An, Ch\'can Th\'de
nh, B\'d7nh Thu\'cbn, Th\'b9ch L\'ad\'acng, Ngh\'dca T\'a9m, Th\'ad\'eeng B\'bbng La, Thanh L\'ad\'acng, C\'b8t Th\'denh, Su\'e8i Bu, \'a7\'e5ng Kh\'aa, S\'acn Th\'denh, Su\'e8i Gi\'b5ng, Ph\'ef Nham, H\'b9nh S\'acn, Ph\'f3c S\'acn, Su\'e8i Quy\'d2n S\'ac
n A, An L\'ad\'acng, S\'acn L\'ad\'acng, N\'cbm B\'f3ng, S\'efng \'a7\'ab, N\'cbm M\'ad\'eai, N\'cbm L\'b5nh, Gia H\'e9i, T\'f3 L\'d6, Ngh\'dca S\'acn v\'b5 c\'b8c th\'de tr\'can n\'abng tr\'ad\'eang Tr\'c7n Ph\'f3, Li\'aan S\'acn, Ngh\'dca L\'e9.  

\par 
\par 2. \'a7i\'d2u ch\'d8nh 850 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.558 nh\'a9n kh\'c8u c\'f1a x\'b7 Y\'aan Th\'beng thu\'e9c huy\'d6n L\'f4c Y\'aan v\'d2 th\'de tr\'can Y\'aan Th\'d5 qu\'b6n l\'fd.
\par 
\par Th\'de tr\'can Y\'aan Th\'d5 c\'e3 1.507 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.229 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can Y\'aan Th\'d5 : \'a7\'abng gi\'b8p x\'b7 Li\'d4u \'a7\'ab; T\'a9y gi\'b8p x\'b7 T\'a9n L\'dcnh; Nam gi\'b8p c\'b8c x\'b7 T\'a9n L\'cbp, Li\'d4u \'a7\'ab; B\'bec gi\'b8p c\'b8c x\'b7 Y\'aan Th\'be
ng, Minh Xu\'a9n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh m\'eb r\'e9ng th\'de tr\'can Y\'aan Th\'d5, x\'b7 Y\'aan Th\'beng c\'dfn l\'b9i 1.548 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.274 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
