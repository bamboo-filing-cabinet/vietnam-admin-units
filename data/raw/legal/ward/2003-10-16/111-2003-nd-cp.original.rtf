\par }\pard\plain \qj\fi540\widctlpar\adjustright \f15\fs28\cgrid {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp c\'b8c ph\'ad\'eang Tu\'c7n Ch\'a9u, H\'efng Th\'beng thu\'e9c th\'b5nh ph\'e8 H\'b9 Long v\'b5 x
\'b7 B\'bec S\'acn thu\'e9c th\'de x\'b7 M\'e3ng C\'b8i, t\'d8nh Qu\'b6ng Ninh nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp ph\'ad\'eang Tu\'c7n Ch\'a9u thu\'e9c th\'b5nh ph\'e8 H\'b9 Long tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a x\'b7 Tu\'c7n Ch\'a9u.
\par 
\par Ph\'ad\'eang Tu\'c7n Ch\'a9u c\'e3 405,4 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.002 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Tu\'c7n Ch\'a9u : \'a7\'abng gi\'b8p ph\'ad\'eang B\'b7i Ch\'b8y; T\'a9y v\'b5 Nam gi\'b8p huy\'d6n Y\'aan H\'adng; B\'bec gi\'b8p ph\'ad\'eang H\'efng Th\'beng v\'b5 x\'b7 Vi\'d6t H\'adng.
\par 
\par 2. Th\'b5nh l\'cbp ph\'ad\'eang H\'efng Th\'beng thu\'e9c th\'b5nh ph\'e8 H\'b9 Long tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a x\'b7 H\'efng Th\'beng.
\par 
\par Ph\'ad\'eang H\'efng Th\'beng c\'e3 389 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.877 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang H\'efng Th\'beng : \'a7\'abng gi\'b8p ph\'ad\'eang B\'b7i Ch\'b8y; T\'a9y gi\'b8p x\'b7 Vi\'d6t H\'adng; Nam gi\'b8p ph\'ad\'eang Tu\'c7n Ch\'a9u; B\'bec gi\'b8p c\'b8c ph\'ad\'eang H\'b5 Kh\'c8u, Gi\'d5ng 
\'a7\'b8y.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 B\'bec S\'acn thu\'e9c th\'de x\'b7 M\'e3ng C\'b8i tr\'aan c\'ac s\'eb 5.043,67 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.216 nh\'a9n kh\'c8u c\'f1a x\'b7 H\'b6i S\'acn.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 B\'bec S\'acn : \'a7\'abng gi\'b8p n\'ad\'edc C\'e9ng ho\'b5 Nh\'a9n d\'a9n Trung Hoa; T\'a9y gi\'b8p x\'b7 H\'b6i S\'acn; Nam gi\'b8p c\'b8c x\'b7 H\'b6i Ti\'d5n, H\'b6i \'a7\'abng, H\'b6i Y\'aan; B\'bec gi\'b8p n
\'ad\'edc C\'e9ng ho\'b5 Nh\'a9n d\'a9n Trung Hoa.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 B\'bec S\'acn, x\'b7 H\'b6i S\'acn c\'dfn l\'b9i 9.881,33 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 842 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i v\'edi Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.

\par 
\par }{\b \'a7i\'d2u 3. }{Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh Qu\'b6ng Ninh, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n
\'b5y ./.
\par }\pard \qj\fi567\widctlpar\adjustright {
