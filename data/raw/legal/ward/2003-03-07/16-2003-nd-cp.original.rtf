\par }\pard \qj\fi540\ri11\widctlpar\tx0\tx9327\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp th\'de tr\'can thu\'e9c c\'b8c huy\'d6n T\'a9n Y\'aan v\'b5 Vi\'d6t Y\'aan, t\'d8nh B\'be
c Giang nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp th\'de tr\'can Nh\'b7 Nam thu\'e9c huy\'d6n T\'a9n Y\'aan tr\'aan c\'ac s\'eb 63,96 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.363 nh\'a9n kh\'c8u c\'f1a x\'b7 Nh\'b7 Nam; 63,20 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 620 nh\'a9n kh\'c8
u c\'f1a x\'b7 An D\'ad\'acng.
\par 
\par Th\'de tr\'can Nh\'b7 Nam c\'e3 127,16 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.983 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can Nh\'b7 Nam : \'a7\'abng gi\'b8p x\'b7 T\'a9n Trung; T\'a9y gi\'b8p c\'b8c x\'b7 Nh\'b7 Nam, An D\'ad\'acng; Nam gi\'b8p c\'b8c x\'b7 An D\'ad\'acng, Li\'aan S\'acn; B\'bec gi\'b8p x\'b7 Nh\'b7 Nam.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can Nh\'b7 Nam :
\par 
\par - X\'b7 Nh\'b7 Nam c\'dfn l\'b9i 350,45 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.847 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 An D\'ad\'acng c\'dfn l\'b9i 1.151,37 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.546 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp th\'de tr\'can N\'d5nh thu\'e9c huy\'d6n Vi\'d6t Y\'aan tr\'aan c\'ac s\'eb 348,58 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.271 nh\'a9n kh\'c8u c\'f1a x\'b7 Ho\'b5ng Ninh; 211,97 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.861 nh\'a9n kh
\'c8u c\'f1a x\'b7 Qu\'b6ng Minh.
\par 
\par Th\'de tr\'can N\'d5nh c\'e3 560,55 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.132 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can N\'d5nh : \'a7\'abng gi\'b8p c\'b8c x\'b7 Ho\'b5ng Ninh, V\'a9n Trung; T\'a9y gi\'b8p c\'b8c x\'b7 Qu\'b6ng Minh, Ninh S\'acn; Nam gi\'b8p x\'b7 Quang Ch\'a9u; B\'bec gi\'b8p x\'b7 Ho\'b5ng Ninh.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can N\'d5nh :
\par 
\par - X\'b7 Ho\'b5ng Ninh c\'dfn l\'b9i 680,83 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.690 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 Qu\'b6ng Minh c\'dfn l\'b9i 550,30 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.007 nh\'a9n kh\'c8u.
\par 
\par }\pard \qj\fi540\ri11\widctlpar\adjustright {\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng c\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'de
nh n\'b5y \'ae\'d2u b\'b7i b\'e1.
