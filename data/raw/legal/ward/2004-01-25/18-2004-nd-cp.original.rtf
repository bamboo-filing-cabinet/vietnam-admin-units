\par 
\par 1. Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca X\'b8 thu\'e9c qu\'cbn L\'aa Ch\'a9n tr\'aan c\'ac s\'eb 64 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.779 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Ni\'d6m Ngh\'dca.
\par 
\par Ph\'ad\'eang Ngh\'dca X\'b8 c\'e3 64 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.779 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca X\'b8: \'a7\'abng gi\'b8p ph\'ad\'eang D\'ad H\'b5ng K\'aanh; T\'a9y gi\'b8p ph\'ad\'eang Ni\'d6m Ngh\'dca; Nam gi\'b8p ph\'ad\'eang V\'dcnh Ni\'d6m v\'b5 qu\'cbn Ki\'d5n An; B\'bec gi\'b8p ph\'ad
\'eang Tr\'c7n Nguy\'aan H\'b7n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca X\'b8, ph\'ad\'eang Ni\'d6m Ngh\'dca c\'dfn l\'b9i 45,91 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.913 nh\'a9n kh\'c8u.
\par }\pard \qj\ri11\sl-320\slmult0\widctlpar\adjustright {
\par }\pard \qj\fi540\ri11\sl-320\slmult0\widctlpar\adjustright {2. S\'b8p nh\'cbp ph\'ad\'eang M\'aa Linh v\'b5o ph\'ad\'eang An Bi\'aan thu\'e9c qu\'cbn L\'aa Ch\'a9n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh s\'b8p nh\'cbp ph\'ad\'eang M\'aa Linh, ph\'ad\'eang An Bi\'aan c\'e3 29 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 12.361 nh\'a9n kh\'c8u:
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang An Bi\'aan: \'a7\'abng gi\'b8p qu\'cbn Ng\'ab Quy\'d2n, T\'a9y gi\'b8p ph\'ad\'eang C\'b8t D\'b5i; Nam gi\'b8p c\'b8c ph\'ad\'eang H\'e5 Nam, Tr\'b9i Cau; B\'bec gi\'b8p qu\'cbn H\'e5ng B\'b5ng.
\par 3. Th\'b5nh l\'cbp x\'b7 L\'adu K\'fa thu\'e9c huy\'d6n Th\'f1y Nguy\'aan tr\'aan c\'ac s\'eb 417,03 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.528 nh\'a9n kh\'c8u c\'f1a x\'b7 L\'adu Ki\'d5m.
\par 
\par X\'b7 L\'adu K\'fa c\'e3 417,03 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.528 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 L\'adu K\'fa: \'a7\'abng gi\'b8p x\'b7 Gia Minh; T\'a9y gi\'b8p x\'b7 Li\'aan Kh\'aa; Nam gi\'b8p x\'b7 L\'adu Ki\'d5m; B\'bec gi\'b8p t\'d8nh Qu\'b6ng Ninh.
\par 
\par Sau \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 L\'adu K\'fa, x\'b7 L\'adu Ki\'d5m c\'dfn l\'b9i 865,36 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.338 nh\'a9n kh\'c8u.
\par 
\par 4. Th\'b5nh l\'cbp x\'b7 Du L\'d4 thu\'e9c huy\'d6n Ki\'d5n Th\'f4y tr\'aan c\'ac s\'eb 301,61 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.649 nh\'a9n kh\'c8u c\'f1a x\'b7 Ki\'d5n Qu\'e8c.
\par 
\par X\'b7 Du L\'d4 c\'e3 301,61 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.649 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Du L\'d4: \'a7\'abng gi\'b8p x\'b7 Th\'f4y H\'ad\'acng; T\'a9y gi\'b8p x\'b7 Ng\'f2 Ph\'f3c; Nam gi\'b8p x\'b7 Ki\'d5n Qu\'e8c; B\'bec gi\'b8p huy\'d6n An L\'b7o.
\par 
\par Sau \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Du L\'d4, x\'b7 Ki\'d5n Qu\'e8c c\'dfn l\'b9i 825,98 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.559 nh\'a9n kh\'c8u.
\par }\pard \qj\fi540\ri11\sb240\sl-320\slmult0\widctlpar\adjustright {\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr
