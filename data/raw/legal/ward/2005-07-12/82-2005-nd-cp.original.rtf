\par }\pard \qj\fi540\widctlpar\adjustright {\b\fs28 
\par \'a7i\'d2u 1. }{\fs28 Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh huy\'d6n \'a7\'bek N\'abng \'ae\'d3 th\'b5nh l\'cbp th\'de x\'b7 Gia Ngh\'dca - th\'de x\'b7 t\'d8nh l\'fe t\'d8nh \'a7\'bek N\'abng, th\'b5nh l\'cbp c\'b8c ph\'ad\'eang, x
\'b7 thu\'e9c th\'de x\'b7 Gia Ngh\'dca v\'b5 \'ae\'e6i t\'aan huy\'d6n \'a7\'bek N\'abng th\'b5nh huy\'d6n \'a7\'bek Glong, t\'d8nh \'a7\'bek N\'abng nh\'ad sau:
\par 
\par 1. Th\'b5nh l\'cbp th\'de x\'b7 Gia Ngh\'dca - th\'de x\'b7 t\'d8nh l\'fe t\'d8nh \'a7\'bek N\'abng tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 d\'a9n s\'e8 c\'f1a th\'de tr\'can Gia Ngh\'dca, x\'b7 Qu\'b6ng Th\'b5nh v\'b5 x\'b7
 \'a7\'bek Nia thu\'e9c huy\'d6n \'a7\'bek N\'abng.
\par 
\par Th\'de x\'b7 Gia Ngh\'dca c\'e3 28.664 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 35.559 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de x\'b7 Gia Ngh\'dca: \'a7\'abng gi\'b8p huy\'d6n \'a7\'bek Glong; T\'a9y gi\'b8p huy\'d6n \'a7\'bek R'L\'cap; Nam gi\'b8p t\'d8nh L\'a9m \'a7\'e5ng; B\'bec gi\'b8p huy\'d6n \'a7\'bek Song.
\par 
\par 2. Th\'b5nh l\'cbp c\'b8c ph\'ad\'eang, x\'b7 thu\'e9c th\'de x\'b7 Gia Ngh\'dca:
\par 
\par a) Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca \'a7\'f8c tr\'aan c\'ac s\'eb 99 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.981 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Gia Ngh\'dca; 333 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 235 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7
\'bek Nia; 1.232 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 710 nh\'a9n kh\'c8u c\'f1a x\'b7 Qu\'b6ng Th\'b5nh.
\par 
\par Ph\'ad\'eang Ngh\'dca \'a7\'f8c c\'e3 di\'d6n t\'ddch t\'f9 nhi\'aan 1.664 ha v\'b5 3.926 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca \'a7\'f8c: \'a7\'abng gi\'b8p x\'b7 \'a7\'bek Nia v\'b5 huy\'d6n \'a7\'bek Glong; T\'a9y gi\'b8p ph\'ad\'eang Ngh\'dca Th\'b5nh; Nam gi\'b8p x\'b7 \'a7\'bek Nia v\'b5 ph\'ad\'eang Ngh\'dca Trung; B
\'bec gi\'b8p x\'b7 Qu\'b6ng Th\'b5nh.
\par 
\par b) Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca Th\'b5nh tr\'aan c\'ac s\'eb 134 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.286 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Gia Ngh\'dca; 152 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.754 nh\'a9n kh\'c8u c\'f1a x\'b7 Qu
\'b6ng Th\'b5nh.
\par 
\par Ph\'ad\'eang Ngh\'dca Th\'b5nh c\'e3 di\'d6n t\'ddch t\'f9 nhi\'aan 286 ha v\'b5 8.040 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca Th\'b5nh: \'a7\'abng gi\'b8p ph\'ad\'eang Ngh\'dca \'a7\'f8c; T\'a9y gi\'b8p ph\'ad\'eang Ngh\'dca Ph\'f3; Nam gi\'b8p ph\'ad\'eang Ngh\'dca T\'a9n; B\'bec gi\'b8p x\'b7 Qu\'b6ng Th\'b5nh.
\par 
\par c) Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca Ph\'f3 tr\'aan c\'ac s\'eb 699 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.828 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Gia Ngh\'dca; 614 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 512 nh\'a9n kh\'c8u c\'f1a x\'b7 Qu\'b6
ng Th\'b5nh.
\par 
\par Ph\'ad\'eang Ngh\'dca Ph\'f3 c\'e3 di\'d6n t\'ddch t\'f9 nhi\'aan 1.313 ha v\'b5 2.340 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca Ph\'f3: \'a7\'abng gi\'b8p ph\'ad\'eang Ngh\'dca Th\'b5nh, ph\'ad\'eang Ngh\'dca T\'a9n; T\'a9y gi\'b8p x\'b7 \'a7\'bek R'Moan; Nam gi\'b8p huy\'d6n \'a7\'bek R'L\'cap v\'b5 ph\'ad\'eang Ngh\'dca T
\'a9n; B\'bec gi\'b8p x\'b7 Qu\'b6ng Th\'b5nh.
\par 
\par d) Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca T\'a9n tr\'aan c\'ac s\'eb 1.215 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.161 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Gia Ngh\'dca; 513 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 484 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7
\'bek Nia.
\par 
\par Ph\'ad\'eang Ngh\'dca T\'a9n c\'e3 di\'d6n t\'ddch t\'f9 nhi\'aan 1.728 ha v\'b5 3.644 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca T\'a9n: \'a7\'abng gi\'b8p ph\'ad\'eang Ngh\'dca Trung; T\'a9y gi\'b8p ph\'ad\'eang Ngh\'dca Ph\'f3 v\'b5 huy\'d6n \'a7\'bek R'L\'cap; Nam gi\'b8p x\'b7 \'a7\'bek Nia; B\'bec gi\'b8p ph\'ad\'ea
ng Ngh\'dca Ph\'f3 v\'b5 ph\'ad\'eang Ngh\'dca Th\'b5nh.
\par 
\par \'ae) Th\'b5nh l\'cbp ph\'ad\'eang Ngh\'dca Trung tr\'aan c\'ac s\'eb 520 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.112 nh\'a9n kh\'c8u c\'f1a th\'de tr\'can Gia Ngh\'dca; 896 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.749 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7
\'bek Nia.
\par 
\par Ph\'ad\'eang Ngh\'dca Trung c\'e3 1.416 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.861 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ngh\'dca Trung: \'a7\'abng gi\'b8p x\'b7 \'a7\'bek Nia; T\'a9y gi\'b8p ph\'ad\'eang Ngh\'dca T\'a9n; Nam gi\'b8p x\'b7 \'a7\'bek Nia; B\'bec gi\'b8p ph\'ad\'eang Ngh\'dca \'a7\'f8c.
\par 
\par e) Th\'b5nh l\'cbp x\'b7 \'a7\'bek R'Moan tr\'aan c\'ac s\'eb 4.956 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'edi 4.045 nh\'a9n kh\'c8u c\'f1a x\'b7 Qu\'b6ng Th\'b5nh.
\par }\pard \qj\fi540\sb240\widctlpar\adjustright {\fs28 X\'b7 \'a7\'bek R'Moan c\'e3 4.956 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.045 nh\'a9n kh\'c8u.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek R'Moan: \'a7\'abng gi\'b8p x\'b7 Qu\'b6ng Th\'b5nh v\'b5 ph\'ad\'eang Ngh\'dca Ph\'f3; T\'a9y gi\'b8p huy\'d6n \'a7\'bek R'L\'cap; Nam gi\'b8p huy\'d6n \'a7\'bek R'L\'cap; B\'bec gi\'b8p huy\'d6n \'a7\'be
k Song.
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp th\'de x\'b7 Gia Ngh\'dca v\'b5 c\'b8c ph\'ad\'eang, x\'b7 tr\'f9c thu\'e9c:
\par }\pard \qj\fi547\sb120\widctlpar\adjustright {\fs28 - Th\'de x\'b7 Gia Ngh\'dca c\'e3 8 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c ph\'ad\'eang Ngh\'dca \'a7\'f8c, Ngh\'dca Th\'b5nh, Ngh\'dca Ph\'f3, Ngh\'dca T\'a9n, Ngh\'dca Trung v
\'b5 c\'b8c x\'b7 \'a7\'bek R'Moan, Qu\'b6ng Th\'b5nh, \'a7\'bek Nia.
\par }{\fs28\expnd-1\expndtw-8 - X\'b7 Qu\'b6ng Th\'b5nh c\'dfn l\'b9i 7.945 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.984 nh\'a9n kh\'c8u.
\par }{\fs28 - X\'b7 \'a7\'bek Nia c\'dfn l\'b9i 9.356 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.719 nh\'a9n kh\'c8u.
\par - Huy\'d6n \'a7\'bek N\'abng c\'dfn l\'b9i 144.228 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 20.504 nh\'a9n kh\'c8u, c\'e3 6 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c l\'b5 c\'b8c x\'b7: Qu\'b6ng Kh\'aa, \'a7\'bek Ha, \'a7\'bek R'M\'a8ng, \'a7\'be
k Plao, \'a7\'bek Som v\'b5 Qu\'b6ng S\'acn. 
\par }\pard \qj\fi540\sb240\widctlpar\adjustright {\fs28 \'a7\'e6i t\'aan huy\'d6n \'a7\'bek N\'abng th\'b5nh huy\'d6n \'a7\'bek Glong.
\par }\pard \qj\fi540\widctlpar\adjustright {\fs28 
\par }{\b\fs28 \'a7i\'d2u 2.}{\fs28  Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.

