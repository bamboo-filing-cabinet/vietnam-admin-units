\par }\pard \qj\fi547\ri14\sl276\slmult1\widctlpar\tx0\tx9327\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp x\'b7, ph\'ad\'eang, th\'de tr\'can thu\'e9c c\'b8c huy\'d6n Tho\'b9i S\'acn, Ph
\'f3 T\'a9n, T\'a9n Ch\'a9u v\'b5 th\'de x\'b7 Ch\'a9u \'a7\'e8c, t\'d8nh An Giang nh\'ad sau :
\par 
\par }{\expnd0\expndtw-4 1. Th\'b5nh l\'cbp ph\'ad\'eang V\'dcnh M\'fc thu\'e9c th\'de x\'b7 Ch\'a9u \'a7\'e8c tr\'aan c\'ac s\'eb 779,6 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 14.870 nh\'a9n kh\'c8u c\'f1a x\'b7 V\'dcnh M\'fc.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang V\'dcnh M\'fc : \'a7\'abng gi\'b8p huy\'d6n Ch\'a9u Ph\'f3; T\'a9y gi\'b8p ph\'ad\'eang Ch\'a9u Ph\'f3 B; Nam gi\'b8p x\'b7 V\'dcnh Ch\'a9u; B\'bec gi\'b8p huy\'d6n Ph\'f3 T\'a9n.
\par 
\par Sau khi th\'b5nh l\'cbp ph\'ad\'eang V\'dcnh M\'fc, x\'b7 V\'dcnh M\'fc c\'dfn l\'b9i 2.168,4 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.357 nh\'a9n kh\'c8u. 
\par 
\par \'a7\'e6i t\'aan x\'b7 V\'dcnh M\'fc th\'b5nh x\'b7 V\'dcnh Ch\'a9u.
\par 
\par 2. Th\'b5nh l\'cbp th\'de tr\'can }{\f17 \'e3}{c Eo thu\'e9c huy\'d6n Tho\'b9i S\'acn tr\'aan c\'ac s\'eb 989,9 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.819 nh\'a9n kh\'c8u c\'f1a x\'b7 V\'e4ng Th\'aa.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can }{\f17 \'e3}{c Eo : \'a7\'abng gi\'b8p x\'b7 V\'e4ng \'a7\'abng; T\'a9y gi\'b8p t\'d8nh Ki\'aan Giang; Nam gi\'b8p x\'b7 B\'d7nh Th\'b5nh v\'b5 t\'d8nh Ki\'aan Giang; B\'bec gi\'b8p x\'b7 V\'e4ng Th\'aa.

\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can }{\f17 \'e3}{c Eo, x\'b7 V\'e4ng Th\'aa c\'dfn l\'b9i 3.700,1 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.558 nh\'a9n kh\'c8u.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 B\'d7nh Th\'b5nh thu\'e9c huy\'d6n Tho\'b9i S\'acn tr\'aan c\'ac s\'eb 837,3 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 498 nh\'a9n kh\'c8u c\'f1a x\'b7 V\'e4ng Th\'aa, 2.111 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.489 nh\'a9n kh
\'c8u c\'f1a x\'b7 Tho\'b9i Giang.
\par 
\par X\'b7 B\'d7nh Th\'b5nh c\'e3 2.948,3 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.987 nh\'a9n kh\'c8u
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 B\'d7nh Th\'b5nh : \'a7\'abng gi\'b8p t\'d8nh C\'c7n Th\'ac; T\'a9y gi\'b8p th\'de tr\'can }{\f17 \'e3}{c Eo v\'b5 t\'d8nh Ki\'aan Giang; Nam gi\'b8p t\'d8nh Ki\'aan Giang; B\'bec gi\'b8p c\'b8c x\'b7 V\'e4ng \'a7
\'abng, Tho\'b9i Giang v\'b5 th\'de tr\'can N\'f3i S\'cbp.
\par }\pard \qj\fi547\ri14\sb240\sl276\slmult1\widctlpar\tx0\tx9327\adjustright {Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 B\'d7nh Th\'b5nh :
\par - X\'b7 V\'e4ng Th\'aa c\'dfn l\'b9i 2.862,8 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.060 nh\'a9n kh\'c8u.
\par - X\'b7 Tho\'b9i Giang c\'dfn l\'b9i 2.616 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.279 nh\'a9n kh\'c8u.
\par 4. Th\'b5nh l\'cbp x\'b7 Long H\'dfa thu\'e9c huy\'d6n Ph\'f3 T\'a9n tr\'aan c\'ac s\'eb 780 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.757 nh\'a9n kh\'c8u c\'f1a x\'b7 Long S\'acn.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Long H\'dfa : \'a7\'abng gi\'b8p t\'d8nh \'a7\'e5ng Th\'b8p; T\'a9y gi\'b8p x\'b7 Long S\'acn; Nam gi\'b8p x\'b7 Ph\'f3 L\'a9m; B\'bec gi\'b8p t\'d8nh \'a7\'e5ng Th\'b8p.
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Long H\'dfa, x\'b7 Long S\'acn c\'dfn l\'b9i 1.299 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.006 nh\'a9n kh\'c8u.
\par 5. Giao 165 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.484 nh\'a9n kh\'c8u c\'f1a x\'b7 Long An thu\'e9c huy\'d6n T\'a9n Ch\'a9u v\'d2 th\'de tr\'can T\'a9n Ch\'a9u qu\'b6n l\'fd.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can T\'a9n Ch\'a9u : \'a7\'abng gi\'b8p huy\'d6n Ph\'f3 T\'a9n; T\'a9y gi\'b8p x\'b7 Long An; Nam gi\'b8p x\'b7 Long Ph\'f3; B\'bec gi\'b8p t\'d8nh \'a7\'e5ng Th\'b8p.
\par }\pard \qj\fi547\ri14\sl276\slmult1\widctlpar\tx0\tx9327\adjustright {
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh m\'eb r\'e9ng th\'de tr\'can T\'a9n Ch\'a9u :
\par 
\par - Th\'de tr\'can T\'a9n Ch\'a9u c\'e3 751 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 36.478 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 Long An c\'dfn l\'b9i 1.197 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.918 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
