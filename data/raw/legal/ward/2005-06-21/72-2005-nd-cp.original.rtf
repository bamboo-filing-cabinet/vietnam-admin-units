\par 
\par 1. Th\'b5nh l\'cbp x\'b7 N\'b5 Nh\'b9n thu\'e9c huy\'d6n \'a7i\'d6n Bi\'aan tr\'aan c\'ac s\'eb 7.681 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.797 nh\'a9n kh\'c8u c\'f1a x\'b7 N\'b5 T\'cau.
\par 
\par X\'b7 N\'b5 Nh\'b9n c\'e3 7.681 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.797 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 N\'b5 Nh\'b9n: \'a7\'abng gi\'b8p x\'b7 N\'b5 T\'cau; T\'a9y gi\'b8p x\'b7 M\'ad\'eang P\'e5n; Nam gi\'b8p x\'b7 M\'ad\'eang Ph\'a8ng v\'b5 th\'b5nh ph\'e8 \'a7i\'d6n Bi\'aan Ph\'f1; B\'bec gi\'b8p c\'b8c x\'b7 N
\'b5 T\'cau, M\'ad\'eang P\'e5n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 N\'b5 Nh\'b9n, x\'b7 N\'b5 T\'cau c\'dfn l\'b9i 7.429 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.017 nh\'a9n kh\'c8u.
\par 
\par }\pard \qj\fi547\ri14\sl276\slmult1\widctlpar\adjustright {\expnd-1\expndtw-6 2. Th\'b5nh l\'cbp x\'b7 Nong U thu\'e9c huy\'d6n \'a7i\'d6n Bi\'aan \'a7\'abng tr\'aan c\'ac s\'eb 7.900 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.478 nh\'a9n kh\'c8u c\'f1
a x\'b7 Pu Nhi.
\par 
\par X\'b7 Nong U c\'e3 7.900 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.478 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Nong U: \'a7\'abng gi\'b8p x\'b7 Na Son; T\'a9y gi\'b8p huy\'d6n \'a7i\'d6n Bi\'aan; Nam gi\'b8p x\'b7 Keo L\'abm; B\'bec gi\'b8p x\'b7 Pu Nhi.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Nong U, x\'b7 Pu Nhi c\'dfn l\'b9i 10.000 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.597 nh\'a9n kh\'c8u.
