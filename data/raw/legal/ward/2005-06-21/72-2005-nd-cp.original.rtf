\par }{\expnd-1\expndtw-6 3. Th\'b5nh l\'cbp x\'b7 P\'f3 H\'e5ng thu\'e9c huy\'d6n \'a7i\'d6n Bi\'aan \'a7\'abng tr\'aan c\'ac s\'eb 12.650 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.443 nh\'a9n kh\'c8u c\'f1a x\'b7 Ph\'d7nh Gi\'b5ng.
\par 
\par X\'b7 P\'f3 H\'e5ng c\'e3 12.650 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.443 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 P\'f3 H\'e5ng: \'a7\'abng gi\'b8p x\'b7 H\'b8ng L\'d7a v\'b5 t\'d8nh S\'acn La; T\'a9y v\'b5 Nam gi\'b8p huy\'d6n \'a7i\'d6n Bi\'aan; B\'bec gi\'b8p x\'b7 Ph\'d7nh Gi\'b5ng.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 P\'f3 H\'e5ng, x\'b7 Ph\'d7nh Gi\'b5ng c\'dfn l\'b9i 10.420 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.940 nh\'a9n kh\'c8u.
\par 
\par }{\expnd0\expndtw-4 4. Th\'b5nh l\'cbp x\'b7 T\'d7a D\'d7nh thu\'e9c huy\'d6n \'a7i\'d6n Bi\'aan \'a7\'abng tr\'aan c\'ac s\'eb 9.882 ha}{ di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.468 nh\'a9n kh\'c8u c\'f1a x\'b7 H\'b8ng L\'d7a.
\par 
\par X\'b7 T\'d7a D\'d7nh c\'e3 9.882 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.468 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 T\'d7a D\'d7nh: \'a7\'abng gi\'b8p t\'d8nh S\'acn La; T\'a9y gi\'b8p x\'b7 Ph\'d7nh Gi\'b5ng; Nam gi\'b8p t\'d8nh S\'acn La; B\'bec gi\'b8p x\'b7 H\'b8ng L\'d7a.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 T\'d7a D\'d7nh, x\'b7 H\'b8ng L\'d7a c\'dfn l\'b9i 6.563 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.336 nh\'a9n kh\'c8u.
\par 
\par 5. Th\'b5nh l\'cbp th\'de tr\'can \'a7i\'d6n Bi\'aan \'a7\'abng - th\'de tr\'can huy\'d6n l\'fe huy\'d6n \'a7i\'d6n Bi\'aan \'a7\'abng tr\'aan c\'ac s\'eb 1.890 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.986 nh\'a9n kh\'c8u c\'f1a x\'b7 Na Son.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can \'a7i\'d6n Bi\'aan \'a7\'abng: \'a7\'abng gi\'b8p x\'b7 Ph\'d7 Nh\'f5; T\'a9y gi\'b8p x\'b7 Na Son; Nam gi\'b8p x\'b7 Keo L\'abm; B\'bec gi\'b8p x\'b7 Na Son.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can \'a7i\'d6n Bi\'aan \'a7\'abng, x\'b7 Na Son c\'dfn l\'b9i 7.359 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.954 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
