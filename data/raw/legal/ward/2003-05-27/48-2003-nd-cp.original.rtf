\par }\pard \qj\fi540\ri11\sl-320\slmult0\widctlpar\adjustright {\b\f17 \'a7}{\b i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp m\'e9t s\'e8 x\'b7, ph\'ad\'eang, th\'de tr\'can thu\'e9c c\'b8c huy\'d6n Ch\'a9
u Th\'b5nh A, \'a4 M\'abn, Ph\'f4ng Hi\'d6p v\'b5 th\'de x\'b7 V\'de Thanh, t\'d8nh C\'c7n Th\'ac nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp th\'de tr\'can M\'e9t Ng\'b5n - th\'de tr\'can huy\'d6n l\'fe huy\'d6n Ch\'a9u Th\'b5nh A tr\'aan c\'ac s\'eb \'aei\'d2u ch\'d8nh 433 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.124 nh\'a9n kh\'c8u c\'f1a x\'b7 T\'a9n Thu\'cbn, 297 ha di
\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.632 nh\'a9n kh\'c8u c\'f1a x\'b7 Nh\'acn Ngh\'dca A.
\par 
\par Th\'de tr\'can M\'e9t Ng\'b5n c\'e3 730 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.756 nh\'a9n kh\'c8u.
\par }\pard \qj\ri11\sl-320\slmult0\widctlpar\adjustright {
\par }\pard \qj\fi540\ri11\sl-320\slmult0\widctlpar\adjustright {\'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de x\'b7 M\'e9t Ng\'b5n : \'a7\'abng gi\'b8p x\'b7 Nh\'acn Ngh\'dca A; T\'a9y gi\'b8p x\'b7 T\'a9n Thu\'cbn v\'b5 x\'b7 Tr\'ad\'eang Long A; Nam gi\'b8p x
\'b7 Th\'b9nh Xu\'a9n v\'b5 huy\'d6n Ph\'f4ng Hi\'d6p; B\'bec gi\'b8p x\'b7 Tr\'ad\'eang Long.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can M\'e9t Ng\'b5n :
\par 
\par - X\'b7 T\'a9n Thu\'cbn c\'dfn l\'b9i 1.578 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.627 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 Nh\'acn Ngh\'dca A c\'dfn l\'b9i 1.543 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.301 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp x\'b7 Xu\'a9n Th\'beng thu\'e9c huy\'d6n \'a4 M\'abn tr\'aan c\'ac s\'eb 1.207,7 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.645 nh\'a9n kh\'c8u c\'f1a x\'b7 Th\'edi Lai.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Xu\'a9n Th\'beng : \'a7\'abng gi\'b8p x\'b7 Th\'edi Th\'b9nh v\'b5 th\'de tr\'can Th\'edi Lai; T\'a9y gi\'b8p x\'b7 \'a7\'abng Hi\'d6p; Nam gi\'b8p x\'b7 Th\'edi Lai; B\'bec gi\'b8p x\'b7 Th\'edi Long.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Xu\'a9n Th\'beng, x\'b7 Th\'edi Lai c\'dfn l\'b9i 2.608,53 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.157 nh\'a9n kh\'c8u.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 T\'a9n Th\'b5nh thu\'e9c huy\'d6n Ph\'f4ng Hi\'d6p tr\'aan c\'ac s\'eb 1.481,1 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.924 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'b9i Th\'b5nh.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 T\'a9n Th\'b5nh : \'a7\'abng gi\'b8p t\'d8nh S\'e3c Tr\'a8ng; T\'a9y gi\'b8p huy\'d6n Ch\'a9u Th\'b5nh; Nam gi\'b8p x\'b7 \'a7\'b9i Th\'b5nh; B\'bec gi\'b8p huy\'d6n Ch\'a9u Th\'b5nh.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 T\'a9n Th\'b5nh, x\'b7 \'a7\'b9i Th\'b5nh c\'dfn l\'b9i 2.696,32 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.486 nh\'a9n kh\'c8u.
\par 
\par 4. Th\'b5nh l\'cbp ph\'ad\'eang VII thu\'e9c th\'de x\'b7 V\'de Thanh tr\'aan c\'ac s\'eb 616 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.625 nh\'a9n kh\'c8u c\'f1a x\'b7 H\'e1a L\'f9u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang VII : \'a7\'abng gi\'b8p ph\'ad\'eang III; T\'a9y gi\'b8p x\'b7 Ho\'b6 Ti\'d5n v\'b5 t\'d8nh Ki\'aan Giang; Nam gi\'b8p x\'b7 H\'e1a L\'f9u; B\'bec gi\'b8p x\'b7 V\'de T\'a9n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp ph\'ad\'eang VII, x\'b7 H\'e1a L\'f9u c\'dfn l\'b9i 1.711 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.122 nh\'a9n kh\'c8u.
\par }\pard \qj\fi540\ri11\sb240\sl-320\slmult0\widctlpar\adjustright {\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr
