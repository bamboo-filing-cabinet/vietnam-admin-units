\par }\pard \qj\ri11\widctlpar\adjustright {
\par }\pard \qc\ri11\widctlpar\adjustright {\b\f17\fs26 Ngh\'de \'ae\'denh :
\par 
\par }\pard \qj\fi547\ri14\sl288\slmult1\widctlpar\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 thu\'e9c huy\'d6n \'a7\'bek T\'ab v\'b5 \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'dd
nh huy\'d6n \'a7\'bek T\'ab \'ae\'d3 th\'b5nh l\'cbp huy\'d6n Tu M\'ac R\'abng, t\'d8nh Kon Tum nh\'ad sau:
\par 
\par 1. Th\'b5nh l\'cbp x\'b7 \'a7\'bek R\'ac Nga thu\'e9c huy\'d6n \'a7\'bek T\'ab tr\'aan c\'ac s\'eb 11.320 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.208 nh\'a9n kh\'c8u c\'f1a x\'b7 Ng\'e4k T\'f4.
\par 
\par X\'b7 \'a7\'bek R\'ac Nga c\'e3 11.320 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.208 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek R\'ac Nga: \'a7\'abng gi\'b8p c\'b8c x\'b7 \'a7\'bek Tr\'a8m, Ng\'e4k T\'f4; T\'a9y gi\'b8p huy\'d6n Ng\'e4c H\'e5i; Nam gi\'b8p x\'b7 Ng\'e4k T\'f4 v\'b5 huy\'d6n Ng\'e4c H\'e5i; B\'bec gi\'b8p c\'b8c x
\'b7 \'a7\'bek Sao, \'a7\'bek T\'ea Kan v\'b5 huy\'d6n Ng\'e4c H\'e5i.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 \'a7\'bek R\'ac Nga, x\'b7 Ng\'e4k T\'f4 c\'dfn l\'b9i 4.730 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.215 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp x\'b7 \'a7\'bek Tr\'a8m thu\'e9c huy\'d6n \'a7\'bek T\'ab tr\'aan c\'ac s\'eb 5.277 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.036 nh\'a9n kh\'c8u c\'f1a x\'b7 V\'a8n Lem.
\par 
\par X\'b7 \'a7\'bek Tr\'a8m c\'e3 5.277 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.036 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek Tr\'a8m: \'a7\'abng gi\'b8p c\'b8c x\'b7 \'a7\'bek H\'b5, V\'a8n Lem; T\'a9y gi\'b8p c\'b8c x\'b7 \'a7\'bek R\'ac Nga, Ng\'e4k T\'f4; Nam gi\'b8p c\'b8c x\'b7 Ng\'e4k T\'f4, Kon \'a7\'b5o, V\'a8n Lem; B
\'bec gi\'b8p x\'b7 \'a7\'bek T\'ea Kan.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 \'a7\'bek Tr\'a8m, x\'b7 V\'a8n Lem c\'dfn l\'b9i 4.463 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.731 nh\'a9n kh\'c8u.
\par 
\par 3. Th\'b5nh l\'cbp x\'b7 \'a7\'bek R\'ac \'a4ng thu\'e9c huy\'d6n \'a7\'bek T\'ab tr\'aan c\'ac s\'eb 6.807 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.619 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'bek T\'ea Kan.
\par 
\par X\'b7 \'a7\'bek R\'ac \'a4ng c\'e3 6.807 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.619 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'bek R\'ac \'a4ng: \'a7\'abng gi\'b8p c\'b8c x\'b7 Tu M\'ac R\'abng, \'a7\'bek T\'ea Kan; T\'a9y gi\'b8p x\'b7 \'a7\'bek Sao; Nam gi\'b8p x\'b7 \'a7\'bek T\'ea Kan; B\'bec gi\'b8p c\'b8c x\'b7 \'a7\'bek Sao, T
\'aa X\'a8ng.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 \'a7\'bek R\'ac \'a4ng, x\'b7 \'a7\'bek T\'ea Kan c\'dfn l\'b9i 6.443 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.215 nh\'a9n kh\'c8u.
\par 
\par 4. Th\'b5nh l\'cbp huy\'d6n Tu M\'ac R\'abng tr\'aan c\'ac s\'eb 86.170 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 21.486 nh\'a9n kh\'c8u c\'f1a huy\'d6n \'a7\'bek T\'ab.
\par 
\par Huy\'d6n Tu M\'ac R\'abng c\'e3 86.170 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 21.486 nh\'a9n kh\'c8u, c\'e3 11 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c l\'b5 c\'b8c x\'b7  \'a7\'bek H\'b5, Tu M\'ac R\'abng, M\'a8ng Ri, Ng\'e4k L\'a9y, T\'aa X
\'a8ng, V\'a8n Xu\'abi, Ng\'e4k Y\'aau, \'a7\'bek T\'ea Kan, \'a7\'bek R\'ac \'a4ng, \'a7\'bek Na, \'a7\'bek Sao.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh huy\'d6n Tu M\'ac R\'abng: \'a7\'abng gi\'b8p huy\'d6n Kon Pl\'abng; T\'a9y gi\'b8p huy\'d6n Ng\'e4c H\'e5i; Nam gi\'b8p c\'b8c huy\'d6n \'a7\'bek T\'ab, \'a7\'bek H\'b5; B\'bec gi\'b8p huy\'d6n \'a7\'bek Glei v\'b5 t
\'d8nh Qu\'b6ng Nam.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp huy\'d6n Tu M\'ac R\'abng:
\par 
\par Huy\'d6n \'a7\'bek T\'ab c\'dfn l\'b9i 51.570 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 29.015 nh\'a9n kh\'c8u, c\'e3 9 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c l\'b5 c\'b8c x\'b7 Di\'aan B\'d7nh, T\'a9n C\'b6nh, Kon \'a7\'b5o, Ng\'e4k T\'f4, \'a7
\'bek R\'ac Nga, V\'a8n Lem, \'a7\'bek Tr\'a8m, P\'ab K\'ab v\'b5 th\'de tr\'can \'a7\'bek T\'ab.
\par 
\par }{\b \'a7i\'d2u 2.}{ Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
\par }{\b \'a7i\'d2u 3. }{\f17\cf1 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh Kon Tum, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n\'b5y ./.
