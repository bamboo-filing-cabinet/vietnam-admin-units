\par }\pard \qj\fi547\ri-86\sb120\widctlpar\adjustright {\expnd0\expndtw-4\cf1 1. Th\'b5nh l\'cbp th\'b5nh ph\'e8 L\'b5o Cai tr\'f9c thu\'e9c t\'d8nh L\'b5o Cai tr\'aan c\'ac s\'eb to\'b5n b\'e9 di\'d6n t\'ddch t\'f9 nhi\'aan, d\'a9n s\'e8 v\'b5 c\'b8c \'ae
\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c c\'f1a th\'de x\'b7 L\'b5o Cai.
\par }{\cf1 Th\'b5nh ph\'e8 L\'b5o Cai c\'e3 22.150 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 100.225 nh\'a9n kh\'c8u, c\'e3 16 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c ph\'ad\'eang: L\'b5o Cai, Ph\'e8 M\'edi, Duy\'aan H\'b6i, C\'e8c L\'d5
u, Kim T\'a9n, Pom H\'b8n, B\'bec L\'d6nh, Th\'e8ng Nh\'cat, Xu\'a9n T\'a8ng v\'b5 c\'b8c x\'b7: B\'bec C\'ad\'eang, Nam C\'ad\'eang, V\'b9n H\'dfa, \'a7\'e5ng Tuy\'d3n, Cam \'a7\'ad\'eang, T\'b6 Ph\'eai v\'b5 H\'eep Th\'b5nh.
\par 2. Th\'b5nh l\'cbp c\'b8c ph\'ad\'eang thu\'e9c th\'b5nh ph\'e8 L\'b5o Cai:
\par a) Th\'b5nh l\'cbp ph\'ad\'eang B\'bec C\'ad\'eang tr\'aan c\'ac s\'eb to\'b5n b\'e9 1.279 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.267 nh\'a9n kh\'c8u c\'f1a x\'b7 B\'bec C\'ad\'eang.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang B\'bec C\'ad\'eang: \'a7\'abng gi\'b8p x\'b7 V\'b9n H\'dfa; T\'a9y gi\'b8p huy\'d6n B\'b8t X\'b8t; Nam gi\'b8p ph\'ad\'eang Nam C\'ad\'eang; B\'bec gi\'b8p ph\'ad\'eang Kim T\'a9n v\'b5 x\'b7 \'a7\'e5ng Tuy
\'d3n.
\par b) Th\'b5nh l\'cbp ph\'ad\'eang Nam C\'ad\'eang tr\'aan c\'ac s\'eb to\'b5n b\'e9 1.117 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.178 nh\'a9n kh\'c8u c\'f1a x\'b7 Nam C\'ad\'eang.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Nam C\'ad\'eang: \'a7\'abng gi\'b8p ph\'ad\'eang B\'bec L\'d6nh; T\'a9y gi\'b8p x\'b7 T\'b6 Ph\'eai; Nam gi\'b8p ph\'ad\'eang B\'bec L\'d6nh v\'b5 x\'b7 Cam \'a7\'ad\'eang; B\'bec gi\'b8p x\'b7 B\'bec C\'ad
\'eang.
\par c) Th\'b5nh l\'cbp ph\'ad\'eang B\'d7nh Minh tr\'aan c\'ac s\'eb \'aei\'d2u ch\'d8nh 1.050 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.518 nh\'a9n kh\'c8u c\'f1a x\'b7 Cam \'a7\'ad\'eang.
\par Ph\'ad\'eang B\'d7nh Minh c\'e3 1.050 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.518 nh\'a9n kh\'c8u.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang B\'d7nh Minh: \'a7\'abng gi\'b8p huy\'d6n B\'b6o Th\'beng; T\'a9y gi\'b8p x\'b7 V\'b9n H\'dfa; Nam gi\'b8p ph\'ad\'eang Th\'e8ng Nh\'cat v\'b5 x\'b7 Cam \'a7\'ad\'eang; B\'bec gi\'b8p x\'b7 V\'b9n H\'dfa v
\'b5 Nam C\'ad\'eang.
\par 3. Sau khi th\'b5nh l\'cbp c\'b8c ph\'ad\'eang thu\'e9c th\'b5nh ph\'e8 L\'b5o Cai:
\par a) Th\'b5nh ph\'e8 L\'b5o Cai c\'e3 17 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c ph\'ad\'eang: L\'b5o Cai, Ph\'e8 M\'edi, Duy\'aan H\'b6i, C\'e8c L\'d5u, Kim T\'a9n, Pom H\'b8n, B\'bec L\'d6nh, Th\'e8ng Nh\'cat, Xu\'a9n T\'a8ng, B
\'bec C\'ad\'eang, Nam C\'ad\'eang, B\'d7nh Minh v\'b5 c\'b8c x\'b7: V\'b9n H\'dfa, \'a7\'e5ng Tuy\'d3n, Cam \'a7\'ad\'eang, T\'b6 Ph\'eai v\'b5 H\'eep Th\'b5nh.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh ph\'e8 L\'b5o Cai: \'a7\'abng gi\'b8p huy\'d6n M\'ad\'eang Kh\'ad\'acng v\'b5 huy\'d6n B\'b6o Th\'beng; T\'a9y gi\'b8p huy\'d6n B\'b8t X\'b8t v\'b5 huy\'d6n Sa Pa; Nam gi\'b8p huy\'d6n B\'b6o Th\'beng; B\'bec gi
\'b8p th\'de tr\'can H\'b5 Kh\'c8u, t\'d8nh V\'a9n Nam - Trung Qu\'e8c v\'edi \'ae\'ad\'eang bi\'aan gi\'edi l\'b5 s\'abng H\'e5ng v\'b5 s\'abng N\'cbm Thi.
\par b) X\'b7 Cam \'a7\'ad\'eang thu\'e9c th\'b5nh ph\'e8 L\'b5o Cai c\'dfn l\'b9i 1.511 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 6.707 nh\'a9n kh\'c8u.
\par }{\b\cf1 \'a7i\'d2u 2}{\cf1 . Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i v\'edi Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b
\'e1.
\par }{\b\expnd0\expndtw-4\cf1 \'a7i\'d2u 3}{\expnd0\expndtw-4\cf1 . Ch\'f1 t\'dech }{\f17\expnd0\expndtw-4\cf1 \'f1}{\expnd0\expndtw-4\cf1 y ban nh\'a9n d\'a9n t\'d8nh L\'b5o Cai, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac
