\par }\pard\plain \qj\fi540\widctlpar\adjustright \f15\fs28\cgrid {\b \'a7i\'d2u 1. }{Nay th\'b5nh l\'cbp th\'de tr\'can thu\'e9c c\'b8c huy\'d6n M\'ad\'eang L\'b8t, Quan S\'acn v\'b5 Ho\'bbng Ho\'b8, t\'d8nh Thanh Ho\'b8 nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp th\'de tr\'can M\'ad\'eang L\'b8t, th\'de tr\'can huy\'d6n l\'fe huy\'d6n M\'ad\'eang L\'b8t tr\'aan c\'ac s\'eb 850 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.850 nh\'a9n kh\'c8u c\'f1a x\'b7 Tam Chung.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can M\'ad\'eang L\'b8t : \'a7\'abng gi\'b8p x\'b7 Tam Chung; T\'a9y gi\'b8p x\'b7 T\'d0n T\'bbn; Nam gi\'b8p x\'b7 P\'ef Nhi; B\'bec gi\'b8p x\'b7 Tam Chung.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can M\'ad\'eang L\'b8t, x\'b7 Tam Chung c\'dfn l\'b9i 12.198,11 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.622 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp th\'de tr\'can Quan S\'acn - th\'de tr\'can huy\'d6n l\'fe huy\'d6n Quan S\'acn tr\'aan c\'ac s\'eb 579,40 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.820 nh\'a9n kh\'c8u c\'f1a x\'b7 S\'acn L\'ad.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can Quan S\'acn : \'a7\'abng gi\'b8p x\'b7 Trung Th\'ad\'eeng; T\'a9y gi\'b8p x\'b7 S\'acn L\'ad; Nam gi\'b8p x\'b7 S\'acn H\'b5; B\'bec gi\'b8p x\'b7 Trung Th\'ad\'eeng.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can Quan S\'acn, x\'b7 S\'acn L\'ad c\'dfn l\'b9i 5.916,87 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.057 nh\'a9n kh\'c8u.
\par 
\par 3. Th\'b5nh l\'cbp th\'de tr\'can T\'b5o Xuy\'aan thu\'e9c huy\'d6n Ho\'bbng Ho\'b8 tr\'aan c\'ac s\'eb 60,80 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.500 nh\'a9n kh\'c8u c\'f1a x\'b7 Ho\'bbng Anh, 168,94 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.114 nh
\'a9n kh\'c8u c\'f1a x\'b7 Ho\'bbng Long, 45,61 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 502 nh\'a9n kh\'c8u c\'f1a x\'b7 Ho\'bbng L\'fd.
\par 
\par Th\'de tr\'can T\'b5o Xuy\'aan c\'e3 275,35 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.116 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh th\'de tr\'can T\'b5o Xuy\'aan : \'a7\'abng gi\'b8p x\'b7 Ho\'bbng Anh; T\'a9y gi\'b8p th\'b5nh ph\'e8 Thanh Ho\'b8; Nam gi\'b8p x\'b7 Ho\'bbng Long; B\'bec gi\'b8p x\'b7 Ho\'bbng L\'fd.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp th\'de tr\'can T\'b5o Xuy\'aan :
\par 
\par - X\'b7 Ho\'bbng Anh c\'dfn l\'b9i 348,86 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.100 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 Ho\'bbng Long c\'dfn l\'b9i 228,73 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.571 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 Ho\'bbng L\'fd c\'dfn l\'b9i 289,50 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.063 nh\'a9n kh\'c8u.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i v\'edi Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.

\par 
