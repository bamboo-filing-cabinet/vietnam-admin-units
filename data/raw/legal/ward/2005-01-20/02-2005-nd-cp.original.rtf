\par }\pard \qj\fi540\ri11\widctlpar\adjustright {\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh, th\'b5nh l\'cbp ph\'ad\'eang thu\'e9c c\'b8c qu\'cbn Ba \'a7\'d7nh, C\'c7u Gi\'cay v\'b5 th\'b5nh l\'cbp th\'de tr\'can Tr\'a9u Qu
\'fa, huy\'d6n Gia L\'a9m, th\'b5nh ph\'e8 H\'b5 N\'e9i nh\'ad sau :
\par 
\par 1. \'a7i\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh v\'b5 th\'b5nh l\'cbp ph\'ad\'eang thu\'e9c qu\'cbn             Ba \'a7\'d7nh :
\par 
\par a) \'a7i\'d2u ch\'d8nh 01 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 200 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang C\'e8ng V\'de v\'d2 ph\'ad\'eang Ng\'e4c Kh\'b8nh qu\'b6n l\'fd.
\par 
\par b) \'a7i\'d2u ch\'d8nh 5,58 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 805 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Ng\'e4c Kh\'b8nh v\'d2 ph\'ad\'eang C\'e8ng V\'de qu\'b6n l\'fd.
\par 
\par c) Th\'b5nh l\'cbp ph\'ad\'eang Li\'d4u Giai tr\'aan c\'ac s\'eb 52,88 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 13.415 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang C\'e8ng V\'de, 19,90 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.226 nh\'a9n kh\'c8u c\'f1a ph\'ad\'ea
ng Ng\'e4c H\'b5.
\par 
\par Ph\'ad\'eang Li\'d4u Giai c\'e3 72,78 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 18.641 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Li\'d4u Giai : \'a7\'abng gi\'b8p c\'b8c ph\'ad\'eang Ng\'e4c H\'b5, \'a7\'e9i C\'can; T\'a9y gi\'b8p c\'b8c ph\'ad\'eang V\'dcnh Ph\'f3c, C\'e8ng V\'de; Nam gi\'b8p c\'b8c ph\'ad\'eang Ng\'e4c Kh\'b8
nh, Kim M\'b7, B\'bec gi\'b8p qu\'cbn T\'a9y H\'e5.
\par 
\par d) Th\'b5nh l\'cbp ph\'ad\'eang V\'dcnh Ph\'f3c tr\'aan c\'ac s\'eb 73,72 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 15.743 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang C\'e8ng V\'de.
\par 
\par Ph\'ad\'eang V\'dcnh Ph\'f3c c\'e3 73,72 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 15.743 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang V\'dcnh Ph\'f3c : \'a7\'abng gi\'b8p ph\'ad\'eang Li\'d4u Giai; T\'a9y gi\'b8p qu\'cbn C\'c7u Gi\'cay, Nam gi\'b8p ph\'ad\'eang C\'e8ng V\'de; B\'bec gi\'b8p qu\'cbn T\'a9y H\'e5.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh, th\'b5nh l\'cbp ph\'ad\'eang:
\par 
\par }{\expnd-1\expndtw-6 - Ph\'ad\'eang C\'e8ng V\'de c\'dfn l\'b9i 52,48 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 14.786 nh\'a9n kh\'c8u.
\par }{
\par }{\expnd-1\expndtw-6 - Ph\'ad\'eang Ng\'e4c H\'b5 c\'dfn l\'b9i 80,10 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 16.774 nh\'a9n kh\'c8u.
\par }{
\par }{\expnd-1\expndtw-6 - Ph\'ad\'eang Ng\'e4c Kh\'b8nh c\'e3 104,42 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 24.395 nh\'a9n kh\'c8u.
\par }{
\par }{\expnd-1\expndtw-6 2. \'a7i\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh v\'b5 th\'b5nh l\'cbp ph\'ad\'eang thu\'e9c qu\'cbn C\'c7u Gi\'cay :
\par }{
\par a) \'a7i\'d2u ch\'d8nh 12,44 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.370 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Quan Hoa v\'d2 ph\'ad\'eang D\'dech V\'e4ng qu\'b6n l\'fd.
\par 
\par b) \'a7i\'d2u ch\'d8nh 48,10 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.898 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang D\'dech V\'e4ng v\'d2 ph\'ad\'eang Quan Hoa qu\'b6n l\'fd.
\par 
\par c) Th\'b5nh l\'cbp ph\'ad\'eang D\'dech V\'e4ng H\'cbu tr\'aan c\'ac s\'eb 52,88 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.684 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Quan Hoa, 94,84 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.281 nh\'a9n kh\'c8u c\'f1a ph\'ad
\'eang D\'dech V\'e4ng.
\par 
\par Ph\'ad\'eang D\'dech V\'e4ng H\'cbu c\'e3 147,72 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 19.965 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang D\'dech V\'e4ng H\'cbu : \'a7\'abng gi\'b8p ph\'ad\'eang D\'dech V\'e4ng; T\'a9y gi\'b8p ph\'ad\'eang Mai D\'dech; Nam gi\'b8p ph\'ad\'eang Y\'aan H\'dfa v\'b5 huy\'d6n T\'f5 Li\'aam; B\'bec gi\'b8p ph\'ad
\'eang Ngh\'dca T\'a9n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh, th\'b5nh l\'cbp ph\'ad\'eang :
\par 
\par }{\expnd-1\expndtw-6 - Ph\'ad\'eang Quan Hoa c\'dfn l\'b9i 82,68 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 19.500 nh\'a9n kh\'c8u.
\par }{
\par }{\expnd-1\expndtw-6 - Ph\'ad\'eang D\'dech V\'e4ng c\'dfn l\'b9i 132,20 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.301 nh\'a9n kh\'c8u.
