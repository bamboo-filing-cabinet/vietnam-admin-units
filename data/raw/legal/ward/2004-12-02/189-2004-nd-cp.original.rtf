ng, t\'d8nh L\'a9m \'a7\'e5ng nh\'ad sau:
\par 
\par }\pard \qj\fi547\sl288\slmult1\widctlpar\adjustright {1. Th\'b5nh l\'cbp x\'b7 \'a7\'b9 Nhim thu\'e9c huy\'d6n L\'b9c D\'ad\'acng tr\'aan c\'ac s\'eb 23.993 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.194 nh\'a9n kh\'c8u c\'f1a x\'b7 \'a7\'b9 Chais.
\par }\pard \fi547\sl288\slmult1\widctlpar\adjustright {
\par X\'b7 \'a7\'b9 Nhim c\'e3 23.993 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 2.194 nh\'a9n kh\'c8u.
\par }\pard \qj\fi547\sl288\slmult1\widctlpar\adjustright {
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'b9 Nhim: \'a7\'abng gi\'b8p x\'b7 \'a7\'b9 Chais; T\'a9y gi\'b8p c\'b8c x\'b7 L\'b8t, \'a7\'adng K'N\'ed; Nam gi\'b8p x\'b7 \'a7\'b9 Sar; B\'bec gi\'b8p t\'d8nh \'a7\'bek L\'bek.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'b9 Nhim, x\'b7 \'a7\'b9 Chais c\'dfn l\'b9i 34.117 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.560 nh\'a9n kh\'c8u.
\par 
\par 2. Th\'b5nh l\'cbp x\'b7 \'a7\'b9 Rsal thu\'e9c huy\'d6n L\'a9m H\'b5 tr\'aan c\'ac s\'eb 7.770 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.935 nh\'a9n kh\'c8u c\'f1a x\'b7 Li\'aang Sr\'abnh v\'b5 706 ha di\'d6n t\'ddch t\'f9 nhi\'aan c\'f1a x\'b7 R\'ab
 Men.
\par 
\par X\'b7 \'a7\'b9 Rsal c\'e3 8.476 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 4.935 nh\'a9n kh\'c8u.
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 \'a7\'b9 Rsal: \'a7\'abng gi\'b8p x\'b7 \'a7\'b9 M'Rong; T\'a9y gi\'b8p t\'d8nh \'a7\'bek N\'abng, Nam gi\'b8p c\'b8c x\'b7 Li\'aang Sr\'abnh, R\'ab Men; B\'bec gi\'b8p t\'d8nh \'a7\'bek L\'bek.
\par 
\par Sau khi th\'b5nh l\'cbp x\'b7 \'a7\'b9 Rsal:
\par 
\par - X\'b7 Li\'aang Sr\'abnh c\'dfn l\'b9i 23.890 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.078 nh\'a9n kh\'c8u.
\par 
\par - X\'b7 R\'ab Men c\'dfn l\'b9i 12.564 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.294 nh\'a9n kh\'c8u.
\par }{\expnd-1\expndtw-8 
\par }{3. Th\'b5nh l\'cbp huy\'d6n \'a7am R\'abng tr\'aan c\'ac s\'eb 28.310 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 12.437 nh\'a9n kh\'c8u (g\'e5m to\'b5n b\'e9 c\'b8c x\'b7 \'a7\'b9 M'Rong, \'a7\'b9 T\'abng, \'a7\'b9 Long) c\'f1a huy\'d6n L\'b9c D\'ad\'ac
ng; 60.910 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 18.196 nh\'a9n kh\'c8u (g\'e5m to\'b5n b\'e9 c\'b8c x\'b7 Li\'aang Sr\'abnh, \'a7\'b9 Rsal, Phi Li\'aang, \'a7\'b9 K'N\'b5ng, R\'ab Men) c\'f1a huy\'d6n L\'a9m H\'b5.
\par 
\par Huy\'d6n \'a7am R\'abng c\'e3 89.220 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 30.633 nh\'a9n kh\'c8u, c\'e3 8 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c x\'b7 \'a7\'b9 M'Rong, \'a7\'b9 T\'abng, \'a7\'b9 Long, Li\'aang Sr\'abnh, \'a7
\'b9 Rsal, Phi Li\'aang, \'a7\'b9 K'N\'b5ng, R\'ab Men.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh huy\'d6n \'a7am R\'abng: \'a7\'abng gi\'b8p huy\'d6n L\'b9c D\'ad\'acng; T\'a9y gi\'b8p t\'d8nh \'a7\'bek N\'abng; Nam gi\'b8p huy\'d6n L\'a9m H\'b5; B\'bec gi\'b8p t\'d8nh \'a7\'bek L\'bek.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp huy\'d6n \'a7am R\'abng:
\par 
\par - Huy\'d6n L\'b9c D\'ad\'acng c\'dfn l\'b9i 123.070 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 16.081 nh\'a9n kh\'c8u, c\'e3 6 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c x\'b7 L\'b8t, \'a7\'b9 Sar, \'a7\'b9 Chais, \'a7\'b9 Nhim, \'a7\'ad
ng K'N\'ed v\'b5 th\'de tr\'can L\'b9c D\'ad\'acng.
\par 
\par - Huy\'d6n L\'a9m H\'b5 c\'dfn l\'b9i 97.852,49 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 133.679 nh\'a9n kh\'c8u, c\'e3 16 \'ae\'acn v\'de h\'b5nh ch\'ddnh tr\'f9c thu\'e9c g\'e5m c\'b8c x\'b7 T\'a9n V\'a8n, \'a7\'b9 \'a7\'ean, Ph\'f3 S\'acn, Phi T\'ab, T
\'a9n H\'b5, Li\'aan H\'b5, Ph\'f3c Th\'e4, Ho\'b5i \'a7\'f8c, \'a7an Ph\'ad\'eeng, T\'a9n Thanh, Nam H\'b5, Gia L\'a9m, \'a7\'abng Thanh, M\'aa Linh v\'b5 c\'b8c th\'de tr\'can \'a7inh V\'a8n, Nam Ban.
\par 
\par }{\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
