\par 
\par Ph\'ad\'eang Ninh Kh\'b8nh c\'e3 535,82 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.027 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang Ninh Kh\'b8nh: \'a7\'abng gi\'b8p huy\'d6n Hoa L\'ad v\'b5 t\'d8nh Nam \'a7\'denh; T\'a9y gi\'b8p x\'b7 Ninh Nh\'cat; Nam gi\'b8p c\'b8c ph\'ad\'eang \'a7\'abng Th\'b5nh, T\'a9n Th\'b5nh; B\'bec gi\'b8p huy
\'d6n Hoa L\'ad.
\par 
