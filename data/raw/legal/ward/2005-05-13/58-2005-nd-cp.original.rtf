nh nh\'ad sau:
\par 
\par 1. \'a7i\'d2u ch\'d8nh 4,55 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.279 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Thanh B\'d7nh thu\'e9c th\'de x\'b7 Ninh B\'d7nh v\'d2 ph\'ad\'eang Nam B\'d7nh qu\'b6n l\'fd.
\par 
\par 2. \'a7i\'d2u ch\'d8nh 26 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.300 nh\'a9n kh\'c8u c\'f1a x\'b7 Ninh S\'acn thu\'e9c th\'de x\'b7 Ninh B\'d7nh v\'d2 ph\'ad\'eang Nam B\'d7nh qu\'b6n l\'fd.
\par 
\par 3. \'a7i\'d2u ch\'d8nh 102,80 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.197 nh\'a9n kh\'c8u c\'f1a x\'b7 Ninh Phong thu\'e9c th\'de x\'b7 Ninh B\'d7nh v\'d2 ph\'ad\'eang Nam B\'d7nh qu\'b6n l\'fd.
\par 
\par }\pard \qj\fi547\widctlpar\adjustright {\fs28 4. \'a7i\'d2u ch\'d8nh 3,37 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 508 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang B\'ddch \'a7\'b5o thu\'e9c th\'de x\'b7 Ninh B\'d7nh v\'d2 x\'b7 Ninh S\'acn qu\'b6n l\'fd.
\par }\pard \qj\fi540\widctlpar\adjustright {\fs28 
\par 5. \'a7i\'d2u ch\'d8nh 36,36 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 1.506 nh\'a9n kh\'c8u c\'f1a ph\'ad\'eang Nam B\'d7nh thu\'e9c th\'de x\'b7 Ninh B\'d7nh v\'d2 x\'b7 Ninh Phong qu\'b6n l\'fd.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh:
\par }\pard \qj\fi540\sb240\widctlpar\adjustright {\fs28\expnd-1\expndtw-6 - Ph\'ad\'eang Thanh B\'d7nh c\'e3 156,54 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.562 nh\'a9n kh\'c8u. 
\par }{\fs28 - Ph\'ad\'eang B\'ddch \'a7\'b5o c\'e3 224,20 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.698 nh\'a9n kh\'c8u.
\par }\pard \qj\fi540\widctlpar\adjustright {\fs28 - Ph\'ad\'eang Nam B\'d7nh c\'e3 185,76 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 9.290 nh\'a9n kh\'c8u.
\par }\pard \qj\fi540\sb240\widctlpar\adjustright {\fs28 - X\'b7 Ninh S\'acn c\'e3 470,01 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 8.054 nh\'a9n kh\'c8u.
\par - X\'b7 Ninh Phong c\'e3 539,16 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 7.701 nh\'a9n kh\'c8u.
\par }\pard \qj\fi540\widctlpar\adjustright {\fs28 
