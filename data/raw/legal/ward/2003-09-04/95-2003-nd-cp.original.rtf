\par }{\b\f17\fs26 ch\'ddnh ph\'f1}{
\par }\pard \qj\fi567\widctlpar\adjustright {
\par C\'a8n c\'f8 Lu\'cbt T\'e6 ch\'f8c Ch\'ddnh ph\'f1 ng\'b5y 25 th\'b8ng 12 n\'a8m 2001;
\par 
\par X\'d0t \'ae\'d2 ngh\'de c\'f1a B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh Ph\'f3 Y\'aan ,
\par 
\par 
\par }\pard \qc\widctlpar\adjustright {\b\f17\fs26 ngh\'de \'ae\'denh :}{\fs26 
\par }\pard \qj\fi567\widctlpar\adjustright {
\par }{\b \'a7i\'d2u 1. }{Nay \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh \'ae\'d3 th\'b5nh l\'cbp x\'b7, ph\'ad\'eang thu\'e9c c\'b8c huy\'d6n S\'abng Hinh, Ph\'f3 Ho\'b5 v\'b5 th\'de x\'b7 Tuy Ho\'b5, t\'d8nh Ph\'f3 Y\'aan nh\'ad sau :
\par 
\par 1. Th\'b5nh l\'cbp x\'b7 Ealy thu\'e9c huy\'d6n S\'abng Hinh tr\'aan c\'ac s\'eb 8.021 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.104 nh\'a9n kh\'c8u c\'f1a x\'b7 Eabar.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ealy : \'a7\'abng gi\'b8p x\'b7 Eabar; T\'a9y gi\'b8p c\'b8c t\'d8nh \'a7\'bek L\'bek, Gia Lai; Nam gi\'b8p t\'d8nh \'a7\'bek L\'bek; B\'bec gi\'b8p t\'d8nh Gia Lai.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp x\'b7 Ealy, x\'b7 Eabar c\'dfn l\'b9i 10.159 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 3.228 nh\'a9n kh\'c8u.
\par 
\par 2. Chia x\'b7 Ho\'b5 Quang thu\'e9c huy\'d6n Ph\'f3 Ho\'b5 th\'b5nh 2 x\'b7 Ho\'b5 Quang Nam v\'b5 Ho\'b5 Quang B\'bec.
\par 
\par - X\'b7 Ho\'b5 Quang Nam c\'e3 3.675,44 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.584 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ho\'b5 Quang Nam : \'a7\'abng gi\'b8p c\'b8c x\'b7 Ho\'b5 Tr\'de, Ho\'b5 Th\'beng; T\'a9y gi\'b8p x\'b7 Ho\'b5 H\'e9i; Nam gi\'b8p c\'b8c x\'b7 Ho\'b5 \'a7\'denh \'a7\'abng, Ho\'b5 \'a7\'denh T\'a9y; B\'bec gi\'b8
p x\'b7 Ho\'b5 Quang B\'bec.
\par 
\par - X\'b7 Ho\'b5 Quang B\'bec c\'e3 5.162,56 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 10.908 nh\'a9n kh\'c8u.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 Ho\'b5 Quang B\'bec : \'a7\'abng gi\'b8p x\'b7 Ho\'b5 Tr\'de v\'b5 th\'de x\'b7 Tuy Ho\'b5; T\'a9y gi\'b8p x\'b7 Ho\'b5 H\'e9i v\'b5 huy\'d6n S\'acn Ho\'b5; Nam gi\'b8p x\'b7 Ho\'b5 Quang Nam; B\'bec gi\'b8p huy
\'d6n Tuy An v\'b5 th\'de x\'b7 Tuy Ho\'b5.
\par 
\par 3. Th\'b5nh l\'cbp ph\'ad\'eang 9 thu\'e9c th\'de x\'b7 Tuy Ho\'b5 tr\'aan c\'ac s\'eb 1.002,8 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 11.872 nh\'a9n kh\'c8u c\'f1a x\'b7 B\'d7nh Ki\'d5n.
\par 
\par \'a7\'dea gi\'edi h\'b5nh ch\'ddnh ph\'ad\'eang 9 : \'a7\'abng gi\'b8p bi\'d3n \'a7\'abng; T\'a9y gi\'b8p x\'b7 Ho\'b5 Ki\'d5n v\'b5 huy\'d6n Ph\'f3 Ho\'b5; Nam gi\'b8p c\'b8c ph\'ad\'eang 5, 7, 8 v\'b5 huy\'d6n Ph\'f3 Ho\'b5; B\'bec gi\'b8p x\'b7 B\'d7
nh Ki\'d5n.
\par 
\par Sau khi \'aei\'d2u ch\'d8nh \'ae\'dea gi\'edi h\'b5nh ch\'ddnh th\'b5nh l\'cbp ph\'ad\'eang 9, x\'b7 B\'d7nh Ki\'d5n c\'dfn l\'b9i 1.269,2 ha di\'d6n t\'ddch t\'f9 nhi\'aan v\'b5 5.998 nh\'a9n kh\'c8u.
\par 
\par }\pard \qj\fi562\sl264\slmult1\widctlpar\adjustright {\b \'a7i\'d2u 2. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. M\'e4i quy \'ae\'denh tr\'ad\'edc \'ae\'a9y tr\'b8i Ngh\'de 
\'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par }\pard \qj\fi562\sl257\slmult1\widctlpar\adjustright {
\par }\pard \qj\fi567\widctlpar\adjustright {\b \'a7i\'d2u 3.}{ Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh Ph\'f3 Y\'aan, B\'e9 tr\'ad\'ebng B\'e9 N\'e9i v\'f4 v\'b5 Th\'f1 tr\'ad\'ebng c\'b8c c\'ac quan c\'e3 li\'aan quan ch\'deu tr\'b8ch nhi
